---
interface Props {
    slug: string;
}

const { slug } = Astro.props;
---

<section class="comments-section">
    <div class="comments-header">
        <h3 class="comments-title">
            Comentarios <span id="comments-count" class="comments-count"></span>
        </h3>
    </div>

    <!-- Formulario para agregar o responder comentario -->
    <form id="comment-form" class="comment-form" data-slug={slug}>
        <!-- Indicador de respuesta activa -->
        <div id="reply-indicator" class="reply-indicator" style="display: none;">
            <span>Respondiendo a <strong id="reply-target-name">@alguien</strong></span>
            <button type="button" id="cancel-reply-btn" class="cancel-reply-btn" title="Cancelar respuesta">
                &times; Cancelar
            </button>
        </div>

        <div class="form-row">
            <div class="form-group flex-1">
                <label for="author_name" class="form-label">Nombre o Apodo</label>
                <input
                    type="text"
                    id="author_name"
                    name="author_name"
                    class="form-input"
                    placeholder="Tu nombre"
                    required
                    autocomplete="off"
                />
            </div>
        </div>

        <div class="form-group">
            <label for="content" class="form-label">Comentario</label>
            <textarea
                id="content"
                name="content"
                class="form-textarea"
                placeholder="Escribe tu comentario aquí..."
                required
                rows="3"
            ></textarea>
        </div>

        <!-- Captcha Matemático Simple -->
        <div class="captcha-row">
            <div class="captcha-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="captcha-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span class="captcha-label">Anti-bot:</span>
                <span id="captcha-question" class="captcha-question">Cargando...</span>
            </div>
            <input
                type="number"
                id="captcha_answer"
                name="captcha_answer"
                class="captcha-input"
                required
                autocomplete="off"
            />
        </div>

        <div id="comment-message" class="form-message"></div>

        <div class="form-actions">
            <button type="submit" id="submit-btn" class="submit-btn">
                Publicar comentario
            </button>
        </div>
    </form>

    <!-- Lista de comentarios estructurada en hilo -->
    <div id="comments-list" class="comments-list">
        <div class="loading-state">Cargando comentarios...</div>
    </div>
</section>

<script>
    function initCommentsSystem() {
        const form = document.getElementById("comment-form") as HTMLFormElement | null;
        const listContainer = document.getElementById("comments-list");
        const captchaLabel = document.getElementById("captcha-question");
        const messageBox = document.getElementById("comment-message");
        const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
        const countBadge = document.getElementById("comments-count");
        const replyIndicator = document.getElementById("reply-indicator");
        const replyTargetName = document.getElementById("reply-target-name");
        const cancelReplyBtn = document.getElementById("cancel-reply-btn");

        if (!form || !listContainer || !captchaLabel || !messageBox || !submitBtn || !countBadge) return;
        if (form.dataset.inited === "true") return;
        form.dataset.inited = "true";

        const slug = form.dataset.slug || window.location.pathname;
        const POCKETBASE_URL = "https://beauchap.daridius.cl";

        let currentReplyToId: string | null = null;

        // Generar captcha matemático aleatorio
        let numA = Math.floor(Math.random() * 8) + 2;
        let numB = Math.floor(Math.random() * 8) + 1;
        let expectedAnswer = numA + numB;
        captchaLabel.textContent = `¿Cuánto es ${numA} + ${numB}?`;

        function refreshCaptcha() {
            numA = Math.floor(Math.random() * 8) + 2;
            numB = Math.floor(Math.random() * 8) + 1;
            expectedAnswer = numA + numB;
            captchaLabel!.textContent = `¿Cuánto es ${numA} + ${numB}?`;
            const answerInput = document.getElementById("captcha_answer") as HTMLInputElement;
            if (answerInput) answerInput.value = "";
        }

        function setReplyTarget(id: string | null, name: string | null) {
            currentReplyToId = id;
            if (id && name && replyIndicator && replyTargetName) {
                replyTargetName.textContent = `@${name}`;
                replyIndicator.style.display = "flex";
                form!.scrollIntoView({ behavior: "smooth", block: "center" });
            } else if (replyIndicator) {
                replyIndicator.style.display = "none";
                currentReplyToId = null;
            }
        }

        if (cancelReplyBtn) {
            cancelReplyBtn.addEventListener("click", () => setReplyTarget(null, null));
        }

        // Cargar comentarios desde PocketBase
        async function fetchComments() {
            try {
                const res = await fetch(
                    `${POCKETBASE_URL}/api/collections/blog_comments/records?filter=(post_slug='${encodeURIComponent(slug)}')&sort=created`
                );
                if (!res.ok) throw new Error("Error al consultar servidor");
                const data = await res.json();
                const items = data.items || [];
                countBadge!.textContent = `(${items.length})`;
                renderCommentsThreaded(items);
            } catch (err) {
                console.error("Error fetching comments:", err);
                listContainer!.innerHTML = `<div class="empty-state">No se pudieron cargar los comentarios.</div>`;
            }
        }

        function renderCommentsThreaded(items: any[]) {
            if (items.length === 0) {
                listContainer!.innerHTML = `<div class="empty-state">Sin comentarios aún. ¡Sé el primero en opinar!</div>`;
                return;
            }

            // Separar comentarios principales y respuestas
            const topLevel = items.filter((item) => !item.reply_to);
            const repliesByParent: Record<string, any[]> = {};

            items.forEach((item) => {
                if (item.reply_to) {
                    if (!repliesByParent[item.reply_to]) repliesByParent[item.reply_to] = [];
                    repliesByParent[item.reply_to].push(item);
                }
            });

            // Si hay comentarios huérfanos con reply_to pero su padre no existe
            const topLevelIds = new Set(topLevel.map((item) => item.id));
            items.forEach((item) => {
                if (item.reply_to && !topLevelIds.has(item.reply_to) && !repliesByParent[item.reply_to]) {
                    topLevel.push(item);
                }
            });

            listContainer!.innerHTML = topLevel
                .map((parent) => renderCommentCard(parent, repliesByParent[parent.id] || []))
                .join("");

            // Escuchar clics en botones de responder
            listContainer!.querySelectorAll(".reply-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const target = e.currentTarget as HTMLElement;
                    const commentId = target.dataset.commentId;
                    const authorName = target.dataset.authorName;
                    if (commentId && authorName) {
                        setReplyTarget(commentId, authorName);
                    }
                });
            });
        }

        function renderCommentCard(comment: any, replies: any[]) {
            const name = escapeHtml(comment.author_name || "Anónimo");
            const initial = name.charAt(0).toUpperCase();
            const dateStr = comment.created ? formatDate(new Date(comment.created)) : "";
            const content = escapeHtml(comment.content || "").replace(/\n/g, "<br/>");

            const repliesHTML = replies.length > 0
                ? `<div class="comment-replies">
                    ${replies.map((reply) => renderSingleReply(reply)).join("")}
                   </div>`
                : "";

            return `
                <div class="comment-card-wrapper" id="comment-${comment.id}">
                    <div class="comment-card">
                        <div class="comment-header">
                            <div class="author-info">
                                <div class="avatar">${initial}</div>
                                <span class="author-name">${name}</span>
                            </div>
                            <span class="comment-date">${dateStr}</span>
                        </div>
                        <div class="comment-body">${content}</div>
                        <div class="comment-footer">
                            <button type="button" class="reply-btn" data-comment-id="${comment.id}" data-author-name="${name}">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>
                                Responder
                            </button>
                        </div>
                    </div>
                    ${repliesHTML}
                </div>
            `;
        }

        function renderSingleReply(reply: any) {
            const name = escapeHtml(reply.author_name || "Anónimo");
            const initial = name.charAt(0).toUpperCase();
            const dateStr = reply.created ? formatDate(new Date(reply.created)) : "";
            const content = escapeHtml(reply.content || "").replace(/\n/g, "<br/>");

            return `
                <div class="comment-card reply-card" id="comment-${reply.id}">
                    <div class="comment-header">
                        <div class="author-info">
                            <div class="avatar avatar-small">${initial}</div>
                            <span class="author-name">${name}</span>
                        </div>
                        <span class="comment-date">${dateStr}</span>
                    </div>
                    <div class="comment-body">${content}</div>
                </div>
            `;
        }

        function formatDate(date: Date) {
            return date.toLocaleDateString("es-CL", {
                day: "numeric",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
            });
        }

        function escapeHtml(str: string) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // Envío de comentario
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            messageBox.textContent = "";
            messageBox.className = "form-message";

            const nameInput = document.getElementById("author_name") as HTMLInputElement;
            const contentInput = document.getElementById("content") as HTMLTextAreaElement;
            const captchaInput = document.getElementById("captcha_answer") as HTMLInputElement;

            const name = nameInput.value.trim();
            const content = contentInput.value.trim();
            const userAnswer = parseInt(captchaInput.value.trim(), 10);

            if (!name || !content) {
                messageBox.textContent = "Por favor completa tu nombre y el comentario.";
                messageBox.className = "form-message error";
                return;
            }

            if (isNaN(userAnswer) || userAnswer !== expectedAnswer) {
                messageBox.textContent = "Respuesta del control anti-bot incorrecta. Inténtalo de nuevo.";
                messageBox.className = "form-message error";
                refreshCaptcha();
                return;
            }

            submitBtn!.disabled = true;
            submitBtn!.textContent = "Publicando...";

            try {
                const payload: any = {
                    post_slug: slug,
                    author_name: name,
                    content: content,
                };
                if (currentReplyToId) {
                    payload.reply_to = currentReplyToId;
                }

                const res = await fetch(`${POCKETBASE_URL}/api/collections/blog_comments/records`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(payload),
                });

                if (!res.ok) {
                    throw new Error("Respuesta inválida del servidor");
                }

                contentInput.value = "";
                captchaInput.value = "";
                setReplyTarget(null, null);
                refreshCaptcha();

                messageBox.textContent = "¡Comentario publicado exitosamente!";
                messageBox.className = "form-message success";

                await fetchComments();
            } catch (err) {
                console.error("Error submitting comment:", err);
                messageBox.textContent = "Ocurrió un error al enviar el comentario. Revisa tu conexión.";
                messageBox.className = "form-message error";
            } finally {
                submitBtn!.disabled = false;
                submitBtn!.textContent = "Publicar comentario";
            }
        });

        fetchComments();
    }

    document.addEventListener("DOMContentLoaded", initCommentsSystem);
    document.addEventListener("astro:page-load", initCommentsSystem);
</script>

<style is:global>
    .comments-section {
        margin-top: 5rem;
        padding-top: 3rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .comments-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .comments-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .comments-count {
        font-size: 1.1rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.4);
        margin-left: 0.4rem;
    }

    /* Formulario principal */
    .comment-form {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 3rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        transition: border-color 0.2s ease;
    }

    .comment-form:focus-within {
        border-color: rgba(255, 255, 255, 0.3);
    }

    .reply-indicator {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.06);
        border-left: 3px solid #ffffff;
        padding: 0.6rem 0.9rem;
        border-radius: 6px;
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.9);
    }

    .reply-indicator strong {
        color: #ffffff;
    }

    .cancel-reply-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .cancel-reply-btn:hover {
        color: #ff6b6b;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.55);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .form-input,
    .form-textarea {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: #ffffff;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
        transition: all 0.2s ease;
    }

    .form-input:focus,
    .form-textarea:focus,
    .captcha-input:focus {
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.07);
    }

    .form-input::placeholder,
    .form-textarea::placeholder,
    .captcha-input::placeholder {
        color: rgba(255, 255, 255, 0.35);
    }

    .form-textarea {
        resize: vertical;
        min-height: 90px;
        line-height: 1.6;
    }

    /* Row para captcha anti-bot */
    .captcha-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.65rem 1rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.2);
        border-radius: 8px;
    }

    .captcha-box {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.88rem;
    }

    .captcha-icon {
        color: rgba(255, 255, 255, 0.4);
    }

    .captcha-label {
        color: rgba(255, 255, 255, 0.5);
    }

    .captcha-question {
        font-weight: 700;
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        letter-spacing: 0.03em;
    }

    .captcha-input {
        width: 80px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 6px;
        padding: 0.4rem 0.6rem;
        color: #ffffff;
        font-weight: 600;
        text-align: center;
        outline: none;
        -moz-appearance: textfield;
        appearance: textfield;
    }

    .captcha-input::-webkit-outer-spin-button,
    .captcha-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .form-message {
        font-size: 0.88rem;
        min-height: 1.2rem;
    }

    .form-message.error {
        color: #ff6b6b;
    }

    .form-message.success {
        color: #51cf66;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
    }

    .submit-btn {
        background: #ffffff;
        color: #000000;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.65rem 1.75rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .submit-btn:hover {
        background: rgba(255, 255, 255, 0.85);
        transform: translateY(-1px);
    }

    .submit-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    /* Lista e Hilos de Comentarios */
    .comments-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .loading-state,
    .empty-state {
        text-align: center;
        padding: 2.5rem;
        color: rgba(255, 255, 255, 0.4);
        font-style: italic;
        font-size: 0.95rem;
    }

    .comment-card-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .comment-card {
        padding: 1.25rem 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        transition: all 0.2s ease;
    }

    .comment-card:hover {
        border-color: rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.035);
    }

    .comment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        color: #ffffff;
        text-transform: uppercase;
    }

    .avatar-small {
        width: 26px;
        height: 26px;
        font-size: 0.75rem;
    }

    .author-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: #ffffff;
    }

    .comment-date {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .comment-body {
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.9);
        white-space: pre-line;
    }

    .comment-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.25rem;
    }

    .reply-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .reply-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-1px);
    }

    /* Respuestas anidadas */
    .comment-replies {
        margin-left: 1.75rem;
        padding-left: 1rem;
        border-left: 2px solid rgba(255, 255, 255, 0.12);
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .reply-card {
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>
