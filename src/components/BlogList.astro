---
import { getCollection, type CollectionEntry } from "astro:content";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
    .filter((post) => !post.data.hidden)
    .sort(
        (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );

const rawTags = [...new Set(posts.flatMap((post) => post.data.tags || []))];
const MAIN_TAGS = ["Sobre mí", "Ideas", "Proyectos", "Reviews"];

const mainTags = MAIN_TAGS.filter((tag) => rawTags.includes(tag));
const otherTags = rawTags.filter((tag) => !MAIN_TAGS.includes(tag)).sort();

import { formatDate } from "../utils/date";

const formatDateShort = (date: Date) =>
    formatDate(date, { month: "short", day: "2-digit", year: "numeric" });
---

<div class="blog-container-layout">
    <header class="blog-header">
        <h1>Bitácora</h1>
        <button id="open-filters-btn" class="open-filters-btn">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M3 6h18M7 12h10M10 18h4"></path>
            </svg>
            <span>Filtros</span>
        </button>
    </header>

    <div
        id="selected-wrapper"
        class="selected-wrapper"
        style="display: none;"
    >
        <span class="filter-subtitle">Seleccionados</span>
        <div id="selected-container" class="selected-container"></div>
    </div>

    <div id="filters-modal" class="filters-modal" style="display: none;">
        <div class="modal-overlay" id="modal-overlay"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Filtros</h3>
                <button id="close-modal-btn" class="close-modal-btn">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 6 6 18M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="filter-groups">
                    <div class="filter-group">
                        <h4 class="filter-group-title">Categorías</h4>
                        <div class="filter-list" id="categories-container">
                            {
                                mainTags.map((tag) => (
                                    <button class="filter-item" data-tag={tag}>
                                        <div class="checkbox" />
                                        <span class="tag-name">{tag}</span>
                                    </button>
                                ))
                            }
                        </div>
                    </div>

                    <div class="filter-group">
                        <h4 class="filter-group-title">Temas</h4>
                        <div class="filter-list" id="tags-container">
                            {
                                otherTags.map((tag) => (
                                    <button class="filter-item" data-tag={tag}>
                                        <div class="checkbox" />
                                        <span class="tag-name">{tag}</span>
                                    </button>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button id="apply-filters-btn" class="apply-filters-btn">
                    Aplicar filtros
                </button>
            </div>
        </div>
    </div>

    <div class="blog-list" id="blog-list">
        {
            posts.map((post) => (
                <a
                    href={`/blog/${post.id}`}
                    class="post-item"
                    data-tags={JSON.stringify(post.data.tags || [])}
                >
                    <div class="post-meta">
                        <time datetime={post.data.pubDate.toISOString()}>
                            {formatDateShort(post.data.pubDate)}
                        </time>
                    </div>
                    <div class="post-info">
                        <h2 class="post-title">{post.data.title}</h2>
                        {post.data.tags && post.data.tags.length > 0 && (
                            <div class="post-tags-row">
                                {post.data.tags.map((tag: string) => (
                                    <span
                                        class={`tag-label ${MAIN_TAGS.includes(tag) ? "is-main" : ""}`}
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        )}
                    </div>
                </a>
            ))
        }
        <div id="no-results" class="no-results" style="display: none;">
            No hay entradas con estos filtros.
        </div>
    </div>
</div>

<script>
    const filterContainers = [
        document.getElementById("categories-container"),
        document.getElementById("tags-container"),
    ];
    const postItems = document.querySelectorAll(".post-item");
    const noResults = document.getElementById("no-results");

    const selectedWrapper = document.getElementById("selected-wrapper");
    const selectedContainer = document.getElementById("selected-container");

    const modal = document.getElementById("filters-modal");
    const openModalBtn = document.getElementById("open-filters-btn");
    const closeModalBtn = document.getElementById("close-modal-btn");
    const applyFiltersBtn = document.getElementById("apply-filters-btn");
    const modalOverlay = document.getElementById("modal-overlay");

    let selectedTags = new Set<string>();
    let tempSelectedTags = new Set<string>();

    // Initial load from URL
    const urlParams = new URLSearchParams(window.location.search);
    const tagsFromUrl = urlParams.get("tags");
    if (tagsFromUrl) {
        tagsFromUrl.split(",").forEach((tag) => {
            if (tag) selectedTags.add(tag);
        });
        refreshFilterUI();
        filterPosts();
    }

    // Abrir modal
    openModalBtn?.addEventListener("click", () => {
        tempSelectedTags = new Set(selectedTags);
        refreshModalUI();
        modal!.style.display = "flex";
        document.body.style.overflow = "hidden";
    });

    // Cerrar modal
    function closeModal() {
        modal!.style.display = "none";
        document.body.style.overflow = "";
    }

    closeModalBtn?.addEventListener("click", closeModal);
    modalOverlay?.addEventListener("click", closeModal);

    // Aplicar filtros y cerrar modal
    applyFiltersBtn?.addEventListener("click", () => {
        selectedTags = new Set(tempSelectedTags);
        applyFilters();
        refreshFilterUI();
        closeModal();
    });

    // Event Delegation for Filter Lists
    filterContainers.forEach((container) => {
        container?.addEventListener("click", (e) => {
            const target = (e.target as HTMLElement).closest(".filter-item");
            if (!target) return;

            const tag = target.getAttribute("data-tag");
            if (tag) {
                if (tempSelectedTags.has(tag)) {
                    tempSelectedTags.delete(tag);
                } else {
                    tempSelectedTags.add(tag);
                }
                refreshModalUI();
            }
        });
    });

    // Event Delegation for Selected List
    selectedContainer?.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement).closest(".filter-item");
        if (!target) return;

        const tag = target.getAttribute("data-tag");
        if (tag) {
            selectedTags.delete(tag);
            applyFilters();
            refreshFilterUI();
        }
    });

    function applyFilters() {
        const newUrl = new URL(window.location.href);
        if (selectedTags.size > 0) {
            newUrl.searchParams.set("tags", Array.from(selectedTags).join(","));
        } else {
            newUrl.searchParams.delete("tags");
        }
        window.history.pushState({}, "", newUrl);
        filterPosts();
    }

    function refreshModalUI() {
        document
            .querySelectorAll(".filter-list .filter-item")
            .forEach((btn) => {
                const tag = btn.getAttribute("data-tag");
                if (tag && tempSelectedTags.has(tag)) {
                    (btn as HTMLElement).classList.add("active");
                } else {
                    (btn as HTMLElement).classList.remove("active");
                }
            });
    }

    function refreshFilterUI() {
        // Toggle wrapper visibility
        if (selectedWrapper) {
            selectedWrapper.style.display =
                selectedTags.size > 0 ? "flex" : "none";
        }

        // Clear container
        if (selectedContainer) selectedContainer.innerHTML = "";

        // Create selected items
        selectedTags.forEach((tag) => {
            const btn = document.createElement("button");
            btn.className = "filter-item selected-item";
            btn.setAttribute("data-tag", tag);

            const checkbox = document.createElement("div");
            checkbox.className = "checkbox";

            const tagName = document.createElement("span");
            tagName.className = "tag-name";
            tagName.textContent = tag;

            btn.appendChild(checkbox);
            btn.appendChild(tagName);

            selectedContainer?.appendChild(btn);
        });

        refreshModalUI();
    }

    function filterPosts() {
        let visibleCount = 0;
        postItems.forEach((item) => {
            const postTags = JSON.parse(item.getAttribute("data-tags") || "[]");
            const matches =
                selectedTags.size === 0 ||
                Array.from(selectedTags).every((tag) => postTags.includes(tag));

            if (matches) {
                (item as HTMLElement).style.display = "grid";
                visibleCount++;
            } else {
                (item as HTMLElement).style.display = "none";
            }
        });

        if (noResults) {
            noResults.style.display = visibleCount === 0 ? "block" : "none";
        }
    }
</script>

<style is:global>
    .blog-container-layout {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .blog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 0;
    }

    .open-filters-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.6rem 1.15rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        width: auto;
        white-space: nowrap;
    }

    .open-filters-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.2);
        color: #fff;
        transform: translateY(-1px);
    }

    .filters-modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fade-in 0.2s ease;
    }

    .modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
    }

    .modal-content {
        position: relative;
        width: 90%;
        max-width: 800px;
        height: 80vh;
        max-height: 600px;
        background: rgba(20, 20, 20, 0.98);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        flex-shrink: 0;
    }

    .modal-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    .close-modal-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border-radius: 8px;
    }

    .close-modal-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
    }

    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
    }

    .modal-footer {
        padding: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        flex-shrink: 0;
    }

    .apply-filters-btn {
        width: 100%;
        padding: 1rem;
        background: #fff;
        color: #000;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .apply-filters-btn:hover {
        background: rgba(255, 255, 255, 0.9);
        transform: translateY(-1px);
    }

    .selected-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        animation: fade-in 0.3s ease;
    }

    .filter-subtitle {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.5;
        font-weight: 600;
    }

    .selected-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .selected-container .filter-item {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .selected-container .filter-item:hover {
        background: rgba(255, 100, 100, 0.2);
        border-color: rgba(255, 100, 100, 0.3);
    }

    .selected-container .checkbox {
        background: #fff;
        border-color: #fff;
    }

    .selected-container .checkbox::after {
        content: "";
        position: absolute;
        width: 4px;
        height: 7px;
        border: solid #000;
        border-width: 0 1.5px 1.5px 0;
        transform: rotate(45deg);
        left: 4px;
        top: 1.5px;
    }

    .filter-groups {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .filter-group-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.8);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .filter-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.35rem;
    }

    .filter-item {
        background: transparent;
        border: none;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        cursor: pointer;
        text-align: left;
        color: rgba(255, 255, 255, 0.4);
        transition: all 0.2s ease;
        width: 100%;
    }

    .filter-item:hover {
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.9);
    }

    .filter-item.active {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }

    .checkbox {
        width: 14px;
        height: 14px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        position: relative;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

    .filter-item.active .checkbox {
        background: #fff;
        border-color: #fff;
    }

    .filter-item.active .checkbox::after {
        content: "";
        position: absolute;
        width: 4px;
        height: 7px;
        border: solid #000;
        border-width: 0 1.5px 1.5px 0;
        transform: rotate(45deg);
        left: 4px;
        top: 1.5px;
    }

    .tag-name {
        font-size: 0.9rem;
        font-weight: 400;
    }

    .blog-list {
        display: flex;
        flex-direction: column;
    }

    .post-item {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 3rem;
        padding: 1.75rem 1rem;
        margin-left: -1rem;
        margin-right: -1rem;
        text-decoration: none;
        color: inherit;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        border-radius: 12px;
    }

    .post-item:hover {
        border-bottom-color: rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.02);
    }

    .post-item:hover .post-title {
        color: #fff;
    }

    .post-meta {
        font-size: 0.9rem;
        opacity: 0.3;
        padding-top: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.02em;
    }

    .post-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .post-title {
        font-size: 1.85rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.95);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        line-height: 1.25;
        letter-spacing: -0.01em;
    }

    .post-tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    .tag-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.2);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .tag-label:not(:last-child)::after {
        content: "•";
        font-size: 0.8rem;
        font-weight: 900;
        opacity: 0.4;
        color: #fff;
    }

    .post-item:hover .tag-label {
        color: rgba(255, 255, 255, 0.45);
    }

    .no-results {
        padding: 8rem 0;
        text-align: center;
        opacity: 0.4;
        font-size: 1.2rem;
        font-weight: 300;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 1024px) {
        .modal-content {
            width: 95%;
            height: 85vh;
        }
    }

    @media (max-width: 768px) {
        .filter-list {
            grid-template-columns: 1fr;
        }

        .post-item {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            padding: 2.5rem 1rem;
        }

        .post-meta {
            padding-top: 0;
        }

        .post-item:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .modal-content {
            width: 100%;
            height: 100vh;
            max-height: 100vh;
            border-radius: 0;
        }

        .selected-container {
            flex-direction: column;
        }
    }
</style>
