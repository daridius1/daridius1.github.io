---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) =>
        (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0),
);

import { formatDate as format } from "../utils/date";

const formatDate = (date?: Date) =>
    format(date, { year: "numeric", month: "short" });
---

<Layout title="Proyectos | daridius">
    <section class="projects-container">
        <header class="projects-header">
            <h1>Proyectos</h1>
        </header>

        <div class="projects-list">
            {
                projects.map((project) => (
                    <a href={`/proyectos/${project.id}`} class="project-item">
                        <div class="project-info">
                            <h2 class="project-title">{project.data.title}</h2>
                            <p class="project-description">
                                {project.data.description}
                            </p>
                        </div>
                        <div class="project-meta">
                            <div class="project-tags">
                                {project.data.tags.slice(0, 2).map((tag) => (
                                    <span class="project-tag">{tag}</span>
                                ))}
                            </div>
                            <span class="project-status">
                                {project.data.status}
                            </span>
                        </div>
                        <svg
                            class="project-arrow"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .projects-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .project-item {
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.75rem;
        background: rgba(255, 255, 255, 0.02);
        border-left: 2px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }

    .project-item:hover {
        background: rgba(255, 255, 255, 0.04);
        border-left-color: rgba(255, 255, 255, 0.3);
        padding-left: 2.25rem;
    }

    .project-info {
        flex: 1;
        min-width: 0;
    }

    .project-title {
        font-size: 1.35rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.35rem;
    }

    .project-description {
        font-size: 0.9rem;
        opacity: 0.4;
        line-height: 1.4;
    }

    .project-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .project-tags {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .project-tag {
        font-size: 0.7rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.3);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .project-tag:not(:last-child)::after {
        content: "•";
        margin-left: 0.5rem;
        opacity: 0.3;
    }

    .project-status {
        font-size: 0.75rem;
        font-weight: 500;
        opacity: 0.4;
        font-style: italic;
    }

    .project-arrow {
        opacity: 0.2;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .project-item:hover .project-arrow {
        opacity: 0.5;
        transform: translateX(5px);
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .project-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .project-meta {
            align-items: flex-start;
            width: 100%;
        }

        .project-arrow {
            display: none;
        }
    }
</style>
