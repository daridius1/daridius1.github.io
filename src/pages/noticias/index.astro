---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const news = (await getCollection("noticias")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

import { formatDate as format } from "../../utils/date";
const formatDate = (date: Date) =>
    format(date, { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="Noticias | daridius">
    <section class="news-list-container">
        <header class="news-list-header">
            <h1>Noticias</h1>
        </header>

        <div class="news-list">
            {
                news.map((item) => (
                    <a href={`/noticias/${item.slug}`} class="news-item">
                        <div class="news-info">
                            <h2 class="news-title">{item.data.title}</h2>
                            <span class="news-location">{item.data.location}</span>
                        </div>
                        <span class="news-date">{formatDate(item.data.pubDate)}</span>
                        <svg
                            class="news-arrow"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .news-list-container {
        padding: 3rem 0 6rem 0;
        max-width: 800px;
        margin: 0 auto;
    }

    .news-list-header {
        margin-bottom: 3rem;
    }

    h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        background: linear-gradient(to bottom, #ffffff, #888888);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    p {
        font-size: 1.25rem;
        opacity: 0.5;
        line-height: 1.6;
    }

    .news-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .news-item {
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-left: 2px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }

    .news-item:hover {
        background: rgba(255, 255, 255, 0.04);
        border-left-color: rgba(255, 255, 255, 0.3);
        padding-left: 2rem;
    }

    .news-info {
        flex: 1;
        min-width: 0;
    }

    .news-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.25rem;
    }

    .news-location {
        font-size: 0.9rem;
        opacity: 0.4;
        line-height: 1.4;
    }

    .news-date {
        font-size: 0.9rem;
        opacity: 0.3;
        font-weight: 500;
        flex-shrink: 0;
    }

    .news-arrow {
        opacity: 0.2;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .news-item:hover .news-arrow {
        opacity: 0.5;
        transform: translateX(5px);
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .news-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .news-arrow {
            display: none;
        }
    }
</style>
