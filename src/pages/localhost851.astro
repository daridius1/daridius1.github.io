---
// Linktree para el Podcast localhost:851
const siteUrl = Astro.site ? Astro.site.toString() : "https://daridius.cl";
const logoUrl = "/images/localhost851.png";

const links = [
    {
        name: "Spotify",
        url: "https://open.spotify.com/show/03457GCvpIB7lrcKSuwZR9",
        handle: "localhost:851",
        icon: "spotify",
        color: "#1DB954",
        featured: true,
    },
    {
        name: "YouTube",
        url: "https://www.youtube.com/@localhost851",
        handle: "@localhost851",
        icon: "youtube",
        color: "#FF0033",
    },
    {
        name: "Instagram",
        url: "https://www.instagram.com/localhost851",
        handle: "@localhost851",
        icon: "instagram",
        color: "#E1306C",
    },
    {
        name: "TikTok",
        url: "https://www.tiktok.com/@localhost851",
        handle: "@localhost851",
        icon: "tiktok",
        color: "#00F2FE",
    },
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>localhost:851 | Podcast de computación</title>
        <meta
            name="description"
            content="Links oficiales del podcast localhost:851. Podcast de computación disponible en Spotify, YouTube, Instagram y TikTok."
        />
        <meta name="theme-color" content="#07090e" />

        <!-- Open Graph / Meta -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={`${siteUrl}localhost851`} />
        <meta property="og:title" content="localhost:851 | Podcast de computación" />
        <meta
            property="og:description"
            content="Links oficiales del podcast localhost:851. Podcast de computación disponible en Spotify, YouTube, Instagram y TikTok."
        />
        <meta property="og:image" content={logoUrl} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="localhost:851 | Podcast de computación" />
        <meta
            name="twitter:description"
            content="Links oficiales del podcast localhost:851."
        />
        <meta name="twitter:image" content={logoUrl} />

        <link rel="icon" type="image/png" href={logoUrl} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <!-- Fondo interactivo con gradiente y efecto de terminal -->
        <div class="bg-effects" aria-hidden="true">
            <div class="glow-sphere glow-blue"></div>
            <div class="glow-sphere glow-purple"></div>
            <div class="grid-overlay"></div>
        </div>

        <main class="linktree-container">
            <!-- Header con Logo y Nombre -->
            <header class="profile-header">
                <div class="avatar-wrapper">
                    <img
                        src={logoUrl}
                        alt="Logo del Podcast localhost:851"
                        class="avatar-image"
                        width="128"
                        height="128"
                        loading="eager"
                    />
                    <div class="pulse-ring"></div>
                </div>

                <div class="brand-title">
                    <span class="host-prefix">localhost</span><span class="port-suffix">:851</span>
                </div>

                <p class="bio-text">Podcast de computación</p>

                <!-- Botones de acción rápida: Copiar @ y Compartir -->
                <div class="quick-actions">
                    <button id="copy-handle-btn" class="pill-btn" title="Copiar nombre de usuario">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span id="copy-btn-text">@localhost851</span>
                    </button>

                    <button id="share-btn" class="pill-btn" title="Compartir este linktree">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                        <span>Compartir</span>
                    </button>
                </div>
            </header>

            <!-- Lista de Enlaces Principales -->
            <section class="links-section" aria-label="Plataformas del podcast">
                {
                    links.map((link) => (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={["link-card", `platform-${link.icon}`, { "is-featured": link.featured }]}
                            style={`--brand-color: ${link.color};`}
                        >
                            <div class="link-icon-container">
                                {link.icon === "spotify" && (
                                    <svg class="icon-svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                                        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
                                    </svg>
                                )}
                                {link.icon === "youtube" && (
                                    <svg class="icon-svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                                    </svg>
                                )}
                                {link.icon === "instagram" && (
                                    <svg class="icon-svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                                    </svg>
                                )}
                                {link.icon === "tiktok" && (
                                    <svg class="icon-svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                                        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.78 1.37-.03 2.59-.83 3.09-2.1.18-.46.25-.96.25-1.46.03-4.58.02-9.16.02-13.74z" />
                                    </svg>
                                )}
                            </div>

                            <div class="link-info">
                                <span class="link-name">{link.name}</span>
                                <span class="link-handle">{link.handle}</span>
                            </div>

                            <div class="link-action">
                                <svg class="chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </div>
                        </a>
                    ))
                }
            </section>
        </main>

        <!-- Toast de Notificación -->
        <div id="toast" class="toast" role="status" aria-live="polite"></div>

        <script>
            // Funcionalidad de Copiar @
            const copyBtn = document.getElementById("copy-handle-btn");
            const copyBtnText = document.getElementById("copy-btn-text");
            const shareBtn = document.getElementById("share-btn");
            const toast = document.getElementById("toast");

            function showToast(message: string) {
                if (!toast) return;
                toast.textContent = message;
                toast.classList.add("visible");
                setTimeout(() => {
                    toast.classList.remove("visible");
                }, 2600);
            }

            if (copyBtn) {
                copyBtn.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText("localhost851");
                        const originalText = copyBtnText?.textContent;
                        if (copyBtnText) copyBtnText.textContent = "¡Copiado!";
                        showToast("¡Usuario @localhost851 copiado al portapapeles!");
                        setTimeout(() => {
                            if (copyBtnText && originalText) copyBtnText.textContent = originalText;
                        }, 2000);
                    } catch {
                        showToast("@localhost851");
                    }
                });
            }

            if (shareBtn) {
                shareBtn.addEventListener("click", async () => {
                    if (navigator.share) {
                        try {
                            await navigator.share({
                                title: "localhost:851 | Podcast",
                                text: "Escucha el podcast localhost:851 en todas las plataformas",
                                url: window.location.href,
                            });
                        } catch (err) {
                            // Usuario canceló o no soportado
                        }
                    } else {
                        try {
                            await navigator.clipboard.writeText(window.location.href);
                            showToast("¡Enlace copiado al portapapeles!");
                        } catch {
                            showToast("Comparte: " + window.location.href);
                        }
                    }
                });
            }
        </script>

        <style>
            :root {
                --bg-dark: #07090e;
                --card-bg: rgba(18, 22, 33, 0.7);
                --card-border: rgba(255, 255, 255, 0.08);
                --card-hover-border: rgba(56, 146, 246, 0.4);
                --text-main: #f3f4f6;
                --text-muted: #9ca3af;
                --blue-accent: #3892f6;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: "Outfit", system-ui, -apple-system, sans-serif;
                background-color: var(--bg-dark);
                color: var(--text-main);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-start;
                padding: 6rem 2rem 5rem;
                overflow-x: hidden;
                position: relative;
            }

            /* Efectos de fondo ambiental */
            .bg-effects {
                position: fixed;
                inset: 0;
                pointer-events: none;
                z-index: 0;
                overflow: hidden;
            }

            .glow-sphere {
                position: absolute;
                border-radius: 50%;
                filter: blur(100px);
                opacity: 0.25;
            }

            .glow-blue {
                width: 380px;
                height: 380px;
                background: radial-gradient(circle, #3892f6 0%, rgba(56, 146, 246, 0) 70%);
                top: -80px;
                left: 50%;
                transform: translateX(-50%);
            }

            .glow-purple {
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, #8b5cf6 0%, rgba(139, 92, 246, 0) 70%);
                bottom: 10%;
                left: 20%;
                opacity: 0.15;
            }

            .grid-overlay {
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
                background-size: 32px 32px;
                opacity: 0.6;
            }

            /* Contenedor principal centrado */
            .linktree-container {
                position: relative;
                z-index: 1;
                width: 100%;
                max-width: 580px;
                padding: 3rem 1.5rem 4rem;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2rem;
            }

            /* Header del perfil */
            .profile-header {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 0.85rem;
                width: 100%;
            }

            .avatar-wrapper {
                position: relative;
                width: 110px;
                height: 110px;
                margin-bottom: 0.25rem;
            }

            .avatar-image {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid rgba(56, 146, 246, 0.6);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 25px rgba(56, 146, 246, 0.35);
                position: relative;
                z-index: 2;
                transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            .avatar-wrapper:hover .avatar-image {
                transform: scale(1.05);
            }

            .pulse-ring {
                position: absolute;
                inset: -6px;
                border-radius: 50%;
                border: 1.5px solid rgba(56, 146, 246, 0.4);
                animation: pulse 3s infinite cubic-bezier(0.4, 0, 0.6, 1);
                z-index: 1;
            }

            @keyframes pulse {
                0%, 100% {
                    transform: scale(1);
                    opacity: 0.4;
                }
                50% {
                    transform: scale(1.08);
                    opacity: 0.8;
                }
            }

            /* Título con estilo terminal */
            .brand-title {
                font-family: "Fira Code", monospace;
                font-size: 2.25rem;
                font-weight: 700;
                letter-spacing: -0.03em;
                line-height: 1;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .host-prefix {
                color: #ffffff;
            }

            .port-suffix {
                color: var(--blue-accent);
                text-shadow: 0 0 16px rgba(56, 146, 246, 0.6);
            }

            /* Tagline Badge */
            .tagline-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background: rgba(56, 146, 246, 0.1);
                border: 1px solid rgba(56, 146, 246, 0.25);
                color: #93c5fd;
                padding: 0.3rem 0.85rem;
                border-radius: 9999px;
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .live-indicator {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background-color: #3b82f6;
                box-shadow: 0 0 8px #3b82f6;
                animation: blink 2s infinite ease-in-out;
            }

            @keyframes blink {
                0%, 100% { opacity: 1; transform: scale(1); }
                50% { opacity: 0.4; transform: scale(0.8); }
            }

            .bio-text {
                font-size: 0.95rem;
                color: var(--text-muted);
                max-width: 440px;
                line-height: 1.5;
            }

            /* Botones rápidos */
            .quick-actions {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.75rem;
                margin-top: 0.5rem;
            }

            .pill-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.1);
                color: #e5e7eb;
                padding: 0.45rem 0.95rem;
                border-radius: 9999px;
                font-size: 0.84rem;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.2s ease;
                font-family: inherit;
            }

            .pill-btn:hover {
                background: rgba(255, 255, 255, 0.08);
                border-color: rgba(255, 255, 255, 0.25);
                color: #ffffff;
                transform: translateY(-1px);
            }

            .pill-btn:active {
                transform: translateY(0);
            }

            /* Lista de Enlaces */
            .links-section {
                width: 100%;
                display: flex;
                flex-direction: column;
                gap: 0.9rem;
            }

            .link-card {
                position: relative;
                display: flex;
                align-items: center;
                gap: 1.1rem;
                padding: 1rem 1.25rem;
                background: var(--card-bg);
                backdrop-filter: blur(16px);
                border: 1px solid var(--card-border);
                border-radius: 16px;
                text-decoration: none;
                color: inherit;
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
                overflow: hidden;
            }

            .link-card::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background: var(--brand-color);
                opacity: 0.6;
                transition: all 0.3s ease;
            }

            .link-card:hover {
                transform: translateY(-3px) scale(1.01);
                border-color: var(--card-hover-border);
                background: rgba(26, 32, 48, 0.85);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(56, 146, 246, 0.15);
            }

            .link-card:hover::before {
                opacity: 1;
                width: 6px;
                box-shadow: 0 0 12px var(--brand-color);
            }

            .link-card.is-featured {
                border-color: rgba(29, 185, 84, 0.35);
                background: linear-gradient(135deg, rgba(29, 185, 84, 0.08) 0%, rgba(18, 22, 33, 0.8) 100%);
            }

            .link-card.is-featured:hover {
                border-color: rgba(29, 185, 84, 0.6);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 25px rgba(29, 185, 84, 0.2);
            }

            /* Icono de Plataforma */
            .link-icon-container {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.08);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                color: var(--brand-color);
                transition: transform 0.3s ease, background 0.3s ease;
            }

            .link-card:hover .link-icon-container {
                transform: scale(1.08);
                background: rgba(255, 255, 255, 0.08);
            }

            .icon-svg {
                display: block;
            }

            /* Información del Enlace */
            .link-info {
                display: flex;
                align-items: baseline;
                gap: 0.75rem;
                flex-grow: 1;
                min-width: 0;
            }

            .link-name {
                font-size: 1.08rem;
                font-weight: 700;
                color: #ffffff;
                letter-spacing: -0.01em;
            }

            .link-handle {
                font-size: 0.84rem;
                font-family: "Fira Code", monospace;
                color: var(--text-muted);
                opacity: 0.75;
            }

            /* Acción / Flecha */
            .link-action {
                display: flex;
                align-items: center;
                flex-shrink: 0;
            }

            .chevron-icon {
                color: rgba(255, 255, 255, 0.3);
                transition: transform 0.3s ease, color 0.3s ease;
            }

            .link-card:hover .chevron-icon {
                transform: translateX(3px);
                color: #ffffff;
            }

            /* Toast */
            .toast {
                position: fixed;
                bottom: 2rem;
                left: 50%;
                transform: translateX(-50%) translateY(100px);
                background: rgba(18, 22, 33, 0.95);
                border: 1px solid rgba(56, 146, 246, 0.5);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 146, 246, 0.3);
                backdrop-filter: blur(12px);
                color: #ffffff;
                font-size: 0.88rem;
                font-weight: 500;
                padding: 0.75rem 1.4rem;
                border-radius: 9999px;
                z-index: 1000;
                opacity: 0;
                pointer-events: none;
                transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
                white-space: nowrap;
            }

            .toast.visible {
                transform: translateX(-50%) translateY(0);
                opacity: 1;
            }

            /* Responsive */
            @media (max-width: 640px) {
                body {
                    padding: 5rem 1.5rem 4rem;
                }

                .link-info {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.15rem;
                }
            }

            @media (max-width: 400px) {
                body {
                    padding: 4.5rem 1.25rem 3.5rem;
                }

                .brand-title {
