---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import Comments from "../../components/Comments.astro";

export async function getStaticPaths() {
    const allEntries = await getCollection("blog");
    const visibleEntries = allEntries
        .filter((post) => !post.data.hidden)
        .sort(
            (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
                b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
        );

    const visiblePaths = visibleEntries.map((entry: CollectionEntry<"blog">, index: number) => ({
        params: { slug: entry.id },
        props: {
            entry,
            prev: index < visibleEntries.length - 1 ? visibleEntries[index + 1] : null,
            next: index > 0 ? visibleEntries[index - 1] : null,
        },
    }));

    const hiddenPaths = allEntries
        .filter((post) => post.data.hidden)
        .map((entry: CollectionEntry<"blog">) => ({
            params: { slug: entry.id },
            props: {
                entry,
                prev: null,
                next: null,
            },
        }));

    return [...visiblePaths, ...hiddenPaths];
}

interface Props {
    entry: CollectionEntry<"blog">;
    prev: CollectionEntry<"blog"> | null;
    next: CollectionEntry<"blog"> | null;
}

import { formatDate } from "../../utils/date";

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | daridius`}>
    <article class="post">
        <header class="post-header">
            <div class="meta">
                <time datetime={entry.data.pubDate.toISOString()}>
                    {formatDate(entry.data.pubDate)}
                </time>
                {
                    entry.data.tags && entry.data.tags.length > 0 && (
                        <div class="tags">
                            {entry.data.tags.map((tag: string) => (
                                <a href={`/blog?tags=${tag}`} class="tag-link">
                                    {tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
            <h1>{entry.data.title}</h1>
            <p class="description">{entry.data.description}</p>
        </header>

        {
            entry.data.match && (
                <section class="match-metadata">
                    <div class="match-header">
                        <span class="label">Crónica de Partido</span>
                        <h2 class="match-title">{entry.data.match.teams}</h2>
                    </div>
                    <div class="match-grid">
                        <div class="match-item">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <>
                                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
                                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
                                    <path d="M4 22h16" />
                                    <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" />
                                    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" />
                                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                                </>
                            </svg>
                            <span>{entry.data.match.competition}</span>
                        </div>
                        <div class="match-item">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <>
                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="18"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </>
                            </svg>
                            <span>{entry.data.match.date}</span>
                        </div>
                        <div class="match-item">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <>
                                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                    <circle cx="12" cy="10" r="3" />
                                </>
                            </svg>
                            <span>{entry.data.match.place}</span>
                        </div>
                    </div>
                </section>
            )
        }

        <div class="content">
            <Content components={{ img: OptimizedImage }} />
        </div>

        {
            entry.data.music && (
                <section class="music-metadata">
                    <div class="music-header">
                        <span class="label">Te vamos a ponerte un tema</span>
                        <div class="music-info">
                            <h3 class="music-title">
                                {entry.data.music.title}
                            </h3>
                            <span class="music-author">
                                por {entry.data.music.author}
                            </span>
                        </div>
                    </div>
                    {entry.data.music.verse && (
                        <p class="music-verse-simple">
                            "{entry.data.music.verse}"
                        </p>
                    )}
                </section>
            )
        }

        <Comments slug={entry.id} />

        <nav class="post-nav">
            <div class="nav-wrapper">
                {
                    prev ? (
                        <a href={`/blog/${prev.id}`} class="nav-card prev">
                            <span class="nav-label">Anterior</span>
                            <span class="nav-title">{prev.data.title}</span>
                        </a>
                    ) : (
                        <div class="nav-empty" />
                    )
                }

                <a href="/blog" class="back-link" title="Volver a la bitácora">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </a>

                {
                    next ? (
                        <a href={`/blog/${next.id}`} class="nav-card next">
                            <span class="nav-label">Siguiente</span>
                            <span class="nav-title">{next.data.title}</span>
                        </a>
                    ) : (
                        <div class="nav-empty" />
                    )
                }
            </div>
        </nav>
    </article>
</Layout>

<style is:global>
    .post {
        max-width: 700px;
        margin: 0 auto;
        padding: 4rem 0;
    }

    .post-header {
        margin-bottom: 4rem;
    }

    .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        opacity: 0.5;
        margin-bottom: 1.5rem;
    }

    .tags {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .tag-link {
        color: inherit;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .tag-link:not(:last-child)::after {
        content: "•";
        font-size: 0.8rem;
        font-weight: 900;
        opacity: 0.3;
        color: #fff;
    }

    .tag-link:hover {
        color: #fff;
        opacity: 1;
        transform: translateY(-1px);
    }

    .post-header h1 {
        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
        padding-bottom: 0.1em;
    }

    .description {
        font-size: 1.4rem;
        line-height: 1.5;
        opacity: 0.7;
        font-style: italic;
    }

    .content {
        line-height: 1.8;
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.9);
    }

    .content h2 {
        font-size: 2rem;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
        color: #fff;
    }

    .content a {
        color: #fff;
        text-decoration: none;
        position: relative;
        transition: color 0.3s ease;
        font-weight: 500;
        background: linear-gradient(
                to right,
                rgba(255, 255, 255, 0.4),
                rgba(255, 255, 255, 0.4)
            )
            no-repeat;
        background-size: 100% 1px;
        background-position: 0 100%;
    }

    .content a:hover {
        color: #fff;
        background-size: 100% 2px;
        background-image: linear-gradient(to right, #fff, #fff);
    }

    .content p {
        margin-bottom: 1.5rem;
    }

    .content ul,
    .content ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }

    .content li {
        margin-bottom: 0.5rem;
    }

    .content blockquote {
        border-left: 3px solid #fff;
        margin: 2.5rem 0;
        padding: 1.5rem 2rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 0 12px 12px 0;
        font-style: italic;
        color: rgba(255, 255, 255, 0.8);
    }

    .content blockquote p {
        margin-bottom: 0;
        line-height: 1.6;
    }

    .content pre {
        background: rgba(255, 255, 255, 0.05);
        padding: 1.5rem;
        border-radius: 12px;
        overflow-x: auto;
        margin: 2rem 0;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .content code {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;
    }

    .content img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 2rem auto;
        border-radius: 12px;
    }

    .image-medium img {
        max-width: 50%;
    }

    .image-caption {
        display: block;
        text-align: center;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
        margin-top: -1.5rem;
        margin-bottom: 2rem;
        font-style: italic;
    }

    .match-metadata,
    .music-metadata {
        margin: 3rem 0;
        padding: 2rem 0;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .match-metadata {
        margin-top: 0; /* Already follows header */
        margin-bottom: 4rem;
    }

    .label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.3);
        margin-bottom: 1rem;
    }

    .match-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 1.5rem;
    }

    .match-grid {
        display: flex;
        gap: 2.5rem;
        flex-wrap: wrap;
    }

    .match-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .match-item svg {
        opacity: 0.4;
    }

    .music-header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .music-info {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .music-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
    }

    .music-author {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .music-verse-simple {
        margin-top: 1.5rem;
        font-style: italic;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.4);
        padding-left: 1.5rem;
        border-left: 2px solid rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 600px) {
        .match-grid {
            flex-direction: column;
            gap: 1rem;
        }

        .music-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
        }
    }

    .post-nav {
        margin-top: 8rem;
        padding-top: 4rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .nav-wrapper {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: stretch;
        gap: 2rem;
    }

    .nav-card {
        text-decoration: none;
        padding: 1.5rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .nav-card:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.1);
        transform: translateY(-4px);
    }

    .nav-card.next {
        text-align: right;
    }

    .nav-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.3);
    }

    .nav-title {
        font-size: 1rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.4;
    }

    .nav-card:hover .nav-title {
        color: #fff;
    }

    .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        transition: all 0.3s ease;
        align-self: center;
    }

    .back-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.1);
        transform: scale(1.05);
    }

    .nav-empty {
        width: 100%;
    }

    @media (max-width: 768px) {
        .post-header h1 {
            font-size: 2.5rem;
        }

        .nav-wrapper {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .back-link {
            grid-row: 1;
            width: 100%;
            height: 40px;
        }

        .nav-card.prev {
            grid-row: 2;
        }
        .nav-card.next {
            grid-row: 3;
        }
        .nav-empty {
            display: none;
        }
    }
</style>
