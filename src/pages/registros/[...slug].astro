---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const registries = await getCollection("registros");
    return registries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"registros">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

import { formatDate as format } from "../../utils/date";

const formatDate = (dateStr: string | undefined | null) =>
    format(dateStr, { year: "numeric", month: "long", day: "numeric" });

// Sort entries if they are dates or have a date property
const sortedItems = [...(entry.data.items || [])];
if (
    entry.data.type === "dates" ||
    sortedItems.some((item) => typeof item !== "string" && item.date)
) {
    sortedItems.sort((a, b) => {
        const getVal = (item: any) => {
            if (typeof item === "string") return item;
            return item.date || "";
        };
        const dateA = new Date(getVal(a)).getTime();
        const dateB = new Date(getVal(b)).getTime();
        if (isNaN(dateA) || isNaN(dateB)) return 0;
        return dateB - dateA;
    });
}

const getLinkLabel = (type: string) => {
    switch (type) {
        case "books":
            return "Ver reseña";
        case "music":
            return "Leer post";
        case "matches":
            return "Ver crónica";
        default:
            return "Ver más";
    }
};
---

<Layout title={`${entry.data.title} | Registros`}>
    <article class="registry-detail">
        <header class="registry-header">
            <h1>{entry.data.title}</h1>
            {
                entry.data.description && (
                    <p class="description">{entry.data.description}</p>
                )
            }
        </header>

        <div class="registry-content">
            <div class="prose">
                <Content />
            </div>

            <div class="items-list">
                <h2 class="list-title">Entradas registradas</h2>
                <div class="entries-grid">
                    {
                        sortedItems.map((item) => (
                            <div
                                class:list={[
                                    "entry-item",
                                    typeof item !== "string" && item.special
                                        ? `is-${item.special}`
                                        : "",
                                ]}
                            >
                                {typeof item === "string" ? (
                                    <span class="entry-value">
                                        {entry.data.type === "dates"
                                            ? formatDate(item)
                                            : item}
                                    </span>
                                ) : (
                                    <div class="entry-card-content">
                                        {entry.data.type === "dates" ? (
                                            <div class="entry-date-row">
                                                <span class="entry-value">
                                                    {formatDate(item.date)}
                                                </span>
                                                {item.title && (
                                                    <span class="entry-label">
                                                        {item.title}
                                                    </span>
                                                )}
                                            </div>
                                        ) : (
                                            <>
                                                <div class="entry-main-info">
                                                    {item.teams ? (
                                                        <span class="entry-title">
                                                            {item.teams}
                                                        </span>
                                                    ) : (
                                                        item.title && (
                                                            <span class="entry-title">
                                                                {item.title}
                                                            </span>
                                                        )
                                                    )}
                                                    {item.author && (
                                                        <span class="entry-author">
                                                            por {item.author}
                                                        </span>
                                                    )}
                                                    {item.competition && (
                                                        <span class="entry-competition">
                                                            {item.competition}
                                                        </span>
                                                    )}
                                                    {item.place && (
                                                        <span class="entry-place">
                                                            {item.place}
                                                        </span>
                                                    )}
                                                </div>
                                                <div class="entry-meta-info">
                                                    {item.date && (
                                                        <span class="entry-date">
                                                            {formatDate(
                                                                item.date,
                                                            )}
                                                        </span>
                                                    )}
                                                    {item.link && (
                                                        <a
                                                            href={item.link}
                                                            class="entry-link"
                                                        >
                                                            {getLinkLabel(
                                                                entry.data.type,
                                                            )}
                                                            <svg
                                                                width="12"
                                                                height="12"
                                                                viewBox="0 0 24 24"
                                                                fill="none"
                                                                stroke="currentColor"
                                                                stroke-width="2.5"
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                            >
                                                                <path d="M7 7h10v10M7 17 17 7" />
                                                            </svg>
                                                        </a>
                                                    )}
                                                </div>
                                            </>
                                        )}
                                    </div>
                                )}
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <nav class="registry-nav">
            <a href="/registros" class="back-link">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path></svg
                >
                Volver a los registros
            </a>
        </nav>
    </article>
</Layout>

<style is:global>
    .registry-detail {
        max-width: 800px;
        margin: 0 auto;
        padding: 3rem 0 6rem 0;
    }

    .registry-header {
        text-align: center;
        margin-bottom: 4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .registry-header h1 {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1.1;
        padding-bottom: 0.1em;
        margin-bottom: 1.5rem;
        color: #fff;
        letter-spacing: -0.04em;
    }

    .description {
        font-size: 1.25rem;
        line-height: 1.6;
        opacity: 0.5;
        max-width: 600px;
    }

    .registry-content {
        margin-top: 4rem;
    }

    .prose {
        line-height: 1.8;
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 4rem;
    }

    .prose a {
        color: #fff;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
        padding-bottom: 2px;
    }

    .prose a:hover {
        border-bottom-color: #fff;
        opacity: 0.8;
    }

    .list-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .entries-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .entry-item {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.25rem 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 12px;
        transition: all 0.2s ease;
    }

    .entry-item:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
    }

    .entry-item.is-silver {
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.05) 0%,
            rgba(200, 200, 200, 0.15) 50%,
            rgba(255, 255, 255, 0.05) 100%
        );
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
    }

    .entry-item.is-silver .entry-title {
        background: linear-gradient(to bottom, #ffffff, #aaaaaa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }

    .entry-date-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .entry-label {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.2rem 0.6rem;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        opacity: 0.8;
        margin-left: auto;
    }

    .is-silver .entry-label {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .entry-value {
        font-size: 1rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.9);
    }

    .entry-card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 2rem;
    }

    .entry-main-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .entry-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: #fff;
    }

    .entry-author,
    .entry-competition,
    .entry-place {
        font-size: 0.9rem;
        opacity: 0.5;
        font-style: italic;
    }

    .entry-meta-info {
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-shrink: 0;
    }

    .entry-date {
        font-size: 0.9rem;
        opacity: 0.4;
        font-weight: 500;
    }

    .entry-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        opacity: 0.6;
        transition: opacity 0.2s ease;
        padding: 0.5rem 0.75rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 8px;
    }

    .entry-link:hover {
        opacity: 1;
        background: rgba(255, 255, 255, 0.06);
    }

    @media (max-width: 600px) {
        .entry-card-content {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .entry-meta-info {
            width: 100%;
            justify-content: space-between;
            gap: 1rem;
        }
    }

    .registry-nav {
        margin-top: 6rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.4);
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .back-link:hover {
        color: #fff;
        transform: translateX(-5px);
    }

    @media (max-width: 768px) {
        .registry-header h1 {
            font-size: 3rem;
        }
    }
</style>
