---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate as format } from "../../utils/date";

const registries = (await getCollection("registros")).sort((a, b) => {
    if (a.id === "blogs-amigos") return 1;
    if (b.id === "blogs-amigos") return -1;
    return 0;
});

const formatDate = (dateStr: string) =>
    format(dateStr, { year: "numeric", month: "short", day: "numeric" });

const getLatest = (registry: any) => {
    if (!registry.data.items || registry.data.items.length === 0) return null;
    const latest = registry.data.items[registry.data.items.length - 1];

    // If it's a simple date string or a date object inside a "dates" type
    if (registry.data.type === "dates") {
        const dateVal = typeof latest === "string" ? latest : latest.date;
        return formatDate(dateVal);
    }

    // If it's an object (like a book or match)
    if (typeof latest === "object" && latest !== null) {
        // For matches, show teams instead of title
        if (registry.data.type === "matches" && latest.teams) {
            return latest.teams;
        }
        return latest.title;
    }

    return latest;
};
---

<Layout title="Registros | daridius">
    <section class="registry-container">
        <header class="registry-header">
            <h1>Registros</h1>
        </header>

        <div class="registry-list">
            {
                registries.map((registry) => {
                    const latest = getLatest(registry);
                    return (
                        <a
                            href={`/registros/${registry.id}`}
                            class="registry-item"
                        >
                            <div class="registry-info">
                                <h2 class="registry-title">
                                    {registry.data.title}
                                </h2>
                                {registry.data.description && (
                                    <p class="registry-description">
                                        {registry.data.description}
                                    </p>
                                )}
                            </div>
                            {latest && registry.data.latestLabel && (
                                <div class="registry-latest">
                                    <span class="latest-label">
                                        {registry.data.latestLabel}:
                                    </span>
                                    <span class="latest-value">{latest}</span>
                                </div>
                            )}
                            <svg
                                class="registry-arrow"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                        </a>
                    );
                })
            }
        </div>
    </section>
</Layout>

<style>
    .registry-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .registry-item {
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-left: 2px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }

    .registry-item:hover {
        background: rgba(255, 255, 255, 0.04);
        border-left-color: rgba(255, 255, 255, 0.3);
        padding-left: 2rem;
    }

    .registry-info {
        flex: 1;
        min-width: 0;
    }

    .registry-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.25rem;
    }

    .registry-description {
        font-size: 0.9rem;
        opacity: 0.4;
        line-height: 1.4;
    }

    .registry-latest {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
        flex-shrink: 0;
    }

    .latest-label {
        font-size: 0.75rem;
        opacity: 0.3;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
    }

    .latest-value {
        font-size: 0.9rem;
        opacity: 0.5;
        font-weight: 500;
    }

    .registry-arrow {
        opacity: 0.2;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .registry-item:hover .registry-arrow {
        opacity: 0.5;
        transform: translateX(5px);
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .registry-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .registry-latest {
            align-items: flex-start;
            width: 100%;
        }

        .registry-arrow {
            display: none;
        }
    }
</style>
