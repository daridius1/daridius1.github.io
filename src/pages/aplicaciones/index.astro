---
import Layout from "../../layouts/Layout.astro";

const apps = [
    {
        name: "TipTap",
        description: "Juego de ritmo y memoria",
        url: "/aplicaciones/tiptap",
    },
    {
        name: "Calculadora de elecciones",
        description: "Calculadora electoral histórica",
        url: "/aplicaciones/elecciones",
    },
    {
        name: "Tazas vs Vasos",
        description: "Experimento físico con tazas y vasos",
        url: "/aplicaciones/stack-game",
    },
];
---

<Layout title="Aplicaciones | daridius">
    <section class="apps-container">
        <header class="apps-header">
            <h1>Aplicaciones</h1>
        </header>

        <div class="apps-list">
            {
                apps.map((app) => (
                    <a href={app.url} class="app-item">
                        <div class="app-info">
                            <h2 class="app-name">{app.name}</h2>
                            <p class="app-description">{app.description}</p>
                        </div>
                        <svg
                            class="app-arrow"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .apps-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .app-item {
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-left: 2px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }

    .app-item:hover {
        background: rgba(255, 255, 255, 0.04);
        border-left-color: rgba(255, 255, 255, 0.3);
        padding-left: 2rem;
    }

    .app-info {
        flex: 1;
        min-width: 0;
    }

    .app-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.25rem;
    }

    .app-description {
        font-size: 0.9rem;
        opacity: 0.4;
        line-height: 1.4;
    }

    .app-arrow {
        opacity: 0.2;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .app-item:hover .app-arrow {
        opacity: 0.5;
        transform: translateX(5px);
    }

    @media (max-width: 768px) {
        .app-arrow {
            display: none;
        }
    }
</style>
