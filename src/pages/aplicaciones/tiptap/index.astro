<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <title>TipTap | Setup</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                --color-1: #3b82f6;
                --color-2: #ef4444;
                --bg-current: var(--color-1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                -webkit-tap-highlight-color: transparent;
                user-select: none;
            }

            body {
                font-family: "Outfit", sans-serif;
                width: 100vw;
                height: 100vh;
                height: 100svh;
                display: flex;
                flex-direction: column;
                transition: background-color 0.4s ease;
                background-color: var(--bg-current);
                color: white;
                overflow: hidden;
                position: fixed;
            }

            /* --- SETUP VIEW --- */
            #setup-view {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2rem;
                gap: 2rem;
                text-align: center;
            }

            .setup-title {
                font-size: 2.5rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .input-group {
                width: 100%;
                max-width: 400px;
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }

            .input-wrapper {
                position: relative;
            }

            .player-input {
                background: rgba(255, 255, 255, 0.1);
                border: 2px solid rgba(255, 255, 255, 0.2);
                padding: 1rem 1.5rem;
                border-radius: 15px;
                color: white;
                font-family: inherit;
                font-size: 1.2rem;
                font-weight: 700;
                outline: none;
                transition: all 0.3s;
                user-select: text;
                width: 100%;
            }

            .player-input:focus {
                border-color: white;
            }

            #name1 {
                border-color: white;
                border-width: 3px;
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
            }

            .start-badge {
                position: absolute;
                top: -12px;
                right: 15px;
                background: white;
                color: #3b82f6;
                padding: 0.3rem 0.8rem;
                border-radius: 20px;
                font-size: 0.7rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

            .starter-selection {
                display: flex;
                gap: 1rem;
                justify-content: center;
                margin-top: 1rem;
            }

            .starter-btn {
                background: rgba(255, 255, 255, 0.1);
                border: 2px solid rgba(255, 255, 255, 0.1);
                padding: 0.8rem 1.2rem;
                border-radius: 12px;
                color: white;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s;
            }

            .starter-btn.active {
                background: white;
                color: black;
                border-color: white;
            }

            .start-game-btn {
                background: white;
                color: black;
                border: none;
                padding: 1.2rem 3rem;
                border-radius: 50px;
                font-size: 1.5rem;
                font-weight: 900;
                text-transform: uppercase;
                cursor: pointer;
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
                transition: transform 0.2s;
            }

            .start-game-btn:active {
                transform: scale(0.95);
            }

            .back-link {
                position: absolute;
                top: 1rem;
                left: 1rem;
                color: rgba(255, 255, 255, 0.6);
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 700;
            }

            .swap-btn {
                background: rgba(255, 255, 255, 0.15);
                border: 2px solid rgba(255, 255, 255, 0.3);
                width: 50px;
                height: 50px;
                border-radius: 50%;
                color: white;
                font-size: 1.5rem;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .swap-btn:hover {
                background: rgba(255, 255, 255, 0.25);
                border-color: rgba(255, 255, 255, 0.5);
                transform: rotate(180deg);
            }

            .swap-btn:active {
                transform: scale(0.9) rotate(180deg);
            }

            .button-row {
                display: flex;
                gap: 1rem;
                justify-content: center;
                align-items: center;
                width: 100%;
            }

            .sound-btn {
                background: rgba(255, 255, 255, 0.15);
                border: 2px solid rgba(255, 255, 255, 0.3);
                width: 50px;
                height: 50px;
                border-radius: 50%;
                color: white;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sound-btn svg {
                width: 20px;
                height: 20px;
            }

            .sound-btn:hover {
                background: rgba(255, 255, 255, 0.25);
                border-color: rgba(255, 255, 255, 0.5);
            }

            .sound-btn:active {
                transform: scale(0.9);
            }

            .sound-btn.muted {
                opacity: 0.5;
            }

            @media (max-height: 500px) {
                .setup-title {
                    font-size: 1.8rem;
                }
            }
        </style>
    </head>
    <body style="background-color: #3b82f6;">
        <section id="setup-view">
            <h1 class="setup-title">TIPTAP</h1>
            <div class="input-group">
                <div class="input-wrapper">
                    <input
                        type="text"
                        id="name1"
                        class="player-input"
                        placeholder="Jugador 1"
                        value="Juan"
                    />
                    <span class="start-badge">PARTE</span>
                </div>
                <div class="input-wrapper">
                    <input
                        type="text"
                        id="name2"
                        class="player-input"
                        placeholder="Jugador 2"
                        value="Jose"
                    />
                </div>
                <div class="button-row">
                    <button id="swapBtn" class="swap-btn">
                        ⇅
                    </button>
                    <button id="soundBtn" class="sound-btn">
                        <svg id="soundIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <button id="startGame" class="start-game-btn">JUGAR</button>
        </section>

        <script>
            const name1 = document.getElementById("name1") as HTMLInputElement;
            const name2 = document.getElementById("name2") as HTMLInputElement;
            const startBtn = document.getElementById(
                "startGame",
            ) as HTMLButtonElement;
            const swapBtn = document.getElementById("swapBtn") as HTMLButtonElement;
            const soundBtn = document.getElementById("soundBtn") as HTMLButtonElement;

            // Estado del sonido (guardado en localStorage)
            let soundEnabled = localStorage.getItem("tiptap-sound") !== "false";
            
            function updateSoundButton() {
                const soundIcon = document.getElementById("soundIcon");
                if (!soundIcon) return;
                
                if (soundEnabled) {
                    soundIcon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>';
                } else {
                    soundIcon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line>';
                }
                soundBtn.classList.toggle("muted", !soundEnabled);
            }
            
            updateSoundButton();

            // Botón de sonido
            soundBtn.onclick = () => {
                soundEnabled = !soundEnabled;
                localStorage.setItem("tiptap-sound", soundEnabled.toString());
                updateSoundButton();
            };

            // Botón para invertir nombres
            swapBtn.onclick = () => {
                const temp = name1.value;
                name1.value = name2.value;
                name2.value = temp;
            };

            startBtn.onclick = () => {
                const n1 = name1.value.trim() || "Jugador 1";
                const n2 = name2.value.trim() || "Jugador 2";

                // El jugador de arriba (p1) siempre empieza primero (start: 0)
                const params = new URLSearchParams({
                    p1: n1,
                    p2: n2,
                    start: "0",
                });
                window.location.href = `/aplicaciones/tiptap/partida?${params.toString()}`;
            };

            // Prevent scroll/zoom on mobile
            document.addEventListener(
                "touchmove",
                (e) => {
                    const target = e.target as HTMLElement;
                    if (
                        target.tagName !== "BUTTON" &&
                        target.tagName !== "INPUT"
                    )
                        e.preventDefault();
                },
                { passive: false },
            );
        </script>
    </body>
</html>
