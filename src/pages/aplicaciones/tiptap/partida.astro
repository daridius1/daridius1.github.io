---
import BallAnimation from "./BallAnimation.astro";
import LossAnimation from "./LossAnimation.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <title>TipTap | Partida</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                --color-1: #3b82f6;
                --color-2: #ef4444;
                --bg-current: var(--color-1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                -webkit-tap-highlight-color: transparent;
                user-select: none;
            }

            body {
                font-family: "Outfit", sans-serif;
                width: 100vw;
                height: 100vh;
                height: 100svh;
                display: flex;
                flex-direction: column;
                transition: background-color 0.4s ease;
                background-color: var(--bg-current);
                color: white;
                overflow: hidden;
                position: fixed;
            }

            .hidden {
                display: none !important;
            }

            /* --- GAME VIEW --- */
            header {
                flex: 0 0 auto;
                padding: 1.5vh 0;
                display: flex;
                justify-content: center;
                background: rgba(0, 0, 0, 0.1);
                width: 100%;
            }

            .totals {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                width: 100%;
                max-width: 800px;
                align-items: center;
            }

            .total-item {
                text-align: center;
            }

            .total-score {
                font-size: min(8vh, 12vw);
                font-weight: 900;
                display: block;
                line-height: 1;
            }

            .total-label {
                font-size: 0.8rem;
                text-transform: uppercase;
                opacity: 0.7;
                letter-spacing: 0.1em;
            }

            main {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2vh;
                min-height: 0;
            }

            .turn-box {
                font-size: 1rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                background: rgba(255, 255, 255, 0.15);
                padding: 0.5rem 1.5rem;
                border-radius: 100px;
                margin-bottom: 2vh;
                transition: opacity 0.3s, transform 0.3s;
            }

            .turn-box.spinning {
                animation: spinOut 0.4s ease-in-out forwards;
            }

            .accum-value {
                font-size: min(25vh, 35vw);
                font-weight: 900;
                line-height: 0.8;
                margin: 1vh 0;
                transition: opacity 0.3s, transform 0.3s;
            }

            .accum-value.spinning {
                animation: spinOut 0.4s ease-in-out forwards;
            }

            @keyframes spinOut {
                0% {
                    transform: rotateY(0deg);
                    opacity: 1;
                }
                100% {
                    transform: rotateY(90deg);
                    opacity: 0;
                }
            }

            @keyframes spinIn {
                0% {
                    transform: rotateY(-90deg);
                    opacity: 0;
                }
                100% {
                    transform: rotateY(0deg);
                    opacity: 1;
                }
            }

            .accum-value.spinning-in,
            .turn-box.spinning-in {
                animation: spinIn 0.4s ease-in-out forwards;
            }

            .controls {
                flex: 0 0 auto;
                padding: 2vh 4vw;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3vw;
                max-width: 800px;
                width: 100%;
                margin: 0 auto;
            }

            .btn {
                border: none;
                border-radius: 15px;
                padding: 3vh 1rem;
                font-family: inherit;
                font-weight: 900;
                cursor: pointer;
                text-transform: uppercase;
                transition:
                    transform 0.1s,
                    opacity 0.2s;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.2rem;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            }

            .btn:active {
                transform: scale(0.95);
            }

            .btn-plus {
                background: white;
                color: black;
                font-size: clamp(0.9rem, 3vw, 1.2rem);
            }

            .btn-dump {
                background: rgba(0, 0, 0, 0.3);
                color: white;
                border: 2px solid rgba(255, 255, 255, 0.2);
                font-size: clamp(0.9rem, 3vw, 1.2rem);
            }

            .btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

            /* --- MODAL STYLES --- */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.8);
                backdrop-filter: blur(10px);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 100;
                padding: 2rem;
            }

            .modal-content {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                padding: 2rem;
                border-radius: 25px;
                text-align: center;
                max-width: 400px;
                width: 100%;
            }

            .modal-title {
                font-size: 1.5rem;
                font-weight: 900;
                margin-bottom: 1rem;
            }

            .modal-actions {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                margin-top: 2rem;
            }

            .btn-modal {
                padding: 1rem;
                border-radius: 15px;
                border: none;
                font-family: inherit;
                font-weight: 700;
                cursor: pointer;
                text-transform: uppercase;
            }

            .btn-confirm {
                background: white;
                color: black;
            }

            .btn-cancel {
                background: rgba(255, 255, 255, 0.1);
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.2);
            }

            .menu-btn {
                background: rgba(0, 0, 0, 0.2);
                border: none;
                color: white;
                padding: 0.5rem;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .header-buttons {
                display: flex;
                gap: 0.5rem;
            }

            .sound-btn {
                background: rgba(0, 0, 0, 0.2);
                border: none;
                color: white;
                padding: 0.5rem;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sound-btn svg {
                width: 20px;
                height: 20px;
            }

            .sound-btn.muted {
                opacity: 0.5;
            }

            .start-game-btn {
                background: white;
                color: black;
                border: none;
                padding: 1.2rem 3rem;
                border-radius: 50px;
                font-size: 1.5rem;
                font-weight: 900;
                text-transform: uppercase;
                cursor: pointer;
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
                transition: transform 0.2s;
            }

            @media (max-height: 500px) {
                header {
                    padding: 0.5rem 1rem;
                }
                .total-score {
                    font-size: 1.2rem;
                }
                .turn-box {
                    font-size: 0.8rem;
                    margin-bottom: 0.5vh;
                }
                .accum-value {
                    font-size: 35vh;
                }
                .btn {
                    padding: 1.5rem 0.5rem;
                }
            }
        </style>
    </head>
    <body>
        <!-- GAME VIEW -->
        <section
            id="game-view"
            style="flex: 1; display: flex; flex-direction: column;"
        >
            <header>
                <div class="totals">
                    <div class="total-item">
                        <span class="total-score" id="score1Val">0</span>
                        <span class="total-label" id="score1Label">P1</span>
                    </div>
                    <div class="header-buttons">
                        <button id="soundBtn" class="sound-btn">
                            <svg id="soundIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                            </svg>
                        </button>
                        <button id="openMenu" class="menu-btn">
                            <svg
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                                ></path>
                            </svg>
                        </button>
                    </div>
                    <div class="total-item">
                        <span class="total-score" id="score2Val">0</span>
                        <span class="total-label" id="score2Label">P2</span>
                    </div>
                </div>
            </header>

            <main>
                <div class="turn-box" id="turnIndicator">Cargando...</div>
                <div class="accum-wrapper" style="position: relative;">
                    <div class="accum-value" id="accumulator">1</div>
                </div>
            </main>
            
            <BallAnimation />
            <LossAnimation />

            <div class="controls">
                <button id="btnSigue" class="btn btn-plus">SIGUE</button>
                <button id="btnPierde" class="btn btn-dump">PIERDE</button>
            </div>
        </section>

        <!-- MODAL -->
        <div id="menu-modal" class="modal-overlay hidden">
            <div class="modal-content">
                <h3 class="modal-title">¿Volver al menú?</h3>
                <p style="opacity: 0.7;">
                    Se perderá el progreso de la partida actual.
                </p>
                <div class="modal-actions">
                    <button id="confirmExit" class="btn-modal btn-confirm"
                        >SÍ, VOLVER AL MENÚ</button
                    >
                    <button id="closeMenu" class="btn-modal btn-cancel"
                        >CANCELAR</button
                    >
                </div>
            </div>
        </div>

        <!-- WINNER VIEW -->
        <section
            id="winner-view"
            class="hidden"
            style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem;"
        >
            <h2
                style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.3em; opacity: 0.8;"
            >
                ¡Tenemos un ganador!
            </h2>
            <h1
                id="winner-name"
                style="font-size: clamp(3rem, 15vw, 6rem); font-weight: 900; margin: 1rem 0;"
            >
                WINNER
            </h1>
            <p style="font-size: 1.2rem; opacity: 0.7; margin-bottom: 3rem;">
                Ha llegado a los 30 puntos.
            </p>
            <button id="playAgain" class="start-game-btn"
                >REPETIR PARTIDA</button
            >
            <button
                id="goMenu"
                style="background: transparent; border: none; color: white; margin-top: 1rem; cursor: pointer; opacity: 0.6; font-weight: 700;"
                >VOLVER AL MENÚ</button
            >
        </section>

        <script>
            // --- STATE ---
            const params = new URLSearchParams(window.location.search);
            const p1 = params.get("p1") || "Jugador 1";
            const p2 = params.get("p2") || "Jugador 2";
            const startParam = params.get("start");
            const startIndex = startParam ? parseInt(startParam) : 0;

            // Estado del sonido
            let soundEnabled = localStorage.getItem("tiptap-sound") !== "false";
            const soundBtn = document.getElementById("soundBtn") as HTMLButtonElement;
            
            // Sistema de audio para success y error
            const successAudio = new Audio("/audio/success_bell-6776.mp3");
            successAudio.volume = 0.8; // Volumen más alto
            // IMPORTANTE: Desactivar 'preservesPitch' para que al cambiar playbackRate cambie también el tono
            (successAudio as any).preservesPitch = false;
            (successAudio as any).mozPreservesPitch = false;
            (successAudio as any).webkitPreservesPitch = false;

            const errorAudio = new Audio("/audio/error-010-206498.mp3");
            errorAudio.volume = 0.35;
            
            function updateSoundButton() {
                const soundIcon = document.getElementById("soundIcon");
                if (soundBtn && soundIcon) {
                    if (soundEnabled) {
                        soundIcon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>';
                    } else {
                        soundIcon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line>';
                    }
                    soundBtn.classList.toggle("muted", !soundEnabled);
                }
            }
            
            updateSoundButton();
            
            if (soundBtn) {
                soundBtn.onclick = () => {
                    soundEnabled = !soundEnabled;
                    localStorage.setItem("tiptap-sound", soundEnabled.toString());
                    updateSoundButton();
                };
            }

            const state = {
                players: [p1, p2],
                scores: [0, 0],
                accumulator: 1,
                activePlayerIndex: startIndex,
                gameOver: false,
            };

            const colors = ["#3b82f6", "#ef4444"];
            const WIN_SCORE = 30;

            // --- DOM ---
            const views = {
                game: document.getElementById("game-view"),
                winner: document.getElementById("winner-view"),
                modal: document.getElementById("menu-modal"),
            };

            const els = {
                score1Val: document.getElementById("score1Val"),
                score2Val: document.getElementById("score2Val"),
                score1Label: document.getElementById("score1Label"),
                score2Label: document.getElementById("score2Label"),
                accumulator: document.getElementById("accumulator"),
                turnIndicator: document.getElementById("turnIndicator"),
                btnSigue: document.getElementById("btnSigue") as HTMLButtonElement | null,
                btnPierde: document.getElementById("btnPierde") as HTMLButtonElement | null,
                openMenu: document.getElementById("openMenu"),
                closeMenu: document.getElementById("closeMenu"),
                confirmExit: document.getElementById("confirmExit"),
                winnerName: document.getElementById("winner-name"),
                playAgain: document.getElementById("playAgain"),
                goMenu: document.getElementById("goMenu"),
            };

            function updateUI() {
                if (
                    state.scores[0] >= WIN_SCORE ||
                    state.scores[1] >= WIN_SCORE
                ) {
                    state.gameOver = true;
                    views.game?.classList.add("hidden");
                    views.winner?.classList.remove("hidden");
                    const winIdx = state.scores[0] >= WIN_SCORE ? 0 : 1;
                    if (els.winnerName)
                        els.winnerName.textContent =
                            state.players[winIdx].toUpperCase();
                    document.body.style.backgroundColor = colors[winIdx];
                    return;
                }

                if (els.score1Val)
                    els.score1Val.textContent = state.scores[0].toString();
                if (els.score2Val)
                    els.score2Val.textContent = state.scores[1].toString();
                if (els.score1Label)
                    els.score1Label.textContent = state.players[0];
                if (els.score2Label)
                    els.score2Label.textContent = state.players[1];
                if (els.accumulator)
                    els.accumulator.textContent = state.accumulator.toString();
                if (els.turnIndicator)
                    els.turnIndicator.textContent = `Turno de ${state.players[state.activePlayerIndex]}`;
                document.body.style.backgroundColor =
                    colors[state.activePlayerIndex];
            }

            if (els.btnSigue) {
                els.btnSigue.onclick = () => {
                    if (state.gameOver) return;
                    
                    // Bloquear botones durante animación
                    if (els.btnSigue) els.btnSigue.disabled = true;
                    if (els.btnPierde) els.btnPierde.disabled = true;
                    
                    const currentValue = state.accumulator;
                    const direction = state.activePlayerIndex === 0 ? "left-to-right" : "right-to-left";
                    
                    // Reproducir sonido de éxito con pitch proporcional al accumulator
                    if (soundEnabled) {
                        successAudio.currentTime = 0;
                        // Pitch proporcional: 1.0 base + 0.06 por cada punto del acumulador
                        successAudio.playbackRate = Math.min(1.0 + (currentValue - 1) * 0.06, 2.0);
                        successAudio.play().catch(() => {});
                    }
                    
                    // 1. Spin-out (salida)
                    if (els.accumulator) els.accumulator.classList.add("spinning");
                    if (els.turnIndicator) els.turnIndicator.classList.add("spinning");
                    
                    setTimeout(() => {
                        // Ocultar después del spin-out
                        if (els.accumulator) els.accumulator.style.display = "none";
                        if (els.turnIndicator) els.turnIndicator.style.display = "none";
                        
                        // 2. Animación de la bola
                        (window as any).animateBall(currentValue, direction, () => {
                            // 3. Actualizar estado y UI mientras están ocultos
                            state.accumulator++;
                            state.activePlayerIndex = state.activePlayerIndex === 0 ? 1 : 0;
                            updateUI();
                            
                            // 4. Resetear estado visual y mostrar
                            if (els.accumulator) {
                                els.accumulator.classList.remove("spinning");
                                els.accumulator.style.opacity = "0";
                                els.accumulator.style.transform = "rotateY(-90deg)";
                                els.accumulator.style.display = "";
                            }
                            if (els.turnIndicator) {
                                els.turnIndicator.classList.remove("spinning");
                                els.turnIndicator.style.opacity = "0";
                                els.turnIndicator.style.transform = "rotateY(-90deg)";
                                els.turnIndicator.style.display = "";
                            }
                            
                            // 5. Aplicar animación en el siguiente frame
                            requestAnimationFrame(() => {
                                if (els.accumulator) {
                                    els.accumulator.style.opacity = "";
                                    els.accumulator.style.transform = "";
                                    els.accumulator.classList.add("spinning-in");
                                }
                                if (els.turnIndicator) {
                                    els.turnIndicator.style.opacity = "";
                                    els.turnIndicator.style.transform = "";
                                    els.turnIndicator.classList.add("spinning-in");
                                }
                                
                                // 6. Limpiar clases y desbloquear botones
                                setTimeout(() => {
                                    if (els.accumulator) els.accumulator.classList.remove("spinning-in");
                                    if (els.turnIndicator) els.turnIndicator.classList.remove("spinning-in");
                                    if (els.btnSigue) els.btnSigue.disabled = false;
                                    if (els.btnPierde) els.btnPierde.disabled = false;
                                }, 400);
                            });
                        });
                    }, 400);
                };
            }
            if (els.btnPierde) {
                els.btnPierde.onclick = () => {
                    if (state.gameOver) return;
                    
                    // Bloquear botones durante animación
                    if (els.btnSigue) els.btnSigue.disabled = true;
                    if (els.btnPierde) els.btnPierde.disabled = true;
                    
                    const currentValue = state.accumulator;
                    
                    // Reproducir sonido de error
                    if (soundEnabled) {
                        errorAudio.currentTime = 0;
                        errorAudio.play().catch(() => {});
                    }
                    
                    // 1. Spin-out (salida)
                    if (els.accumulator) els.accumulator.classList.add("spinning");
                    if (els.turnIndicator) els.turnIndicator.classList.add("spinning");
                    
                    setTimeout(() => {
                        // Ocultar después del spin-out
                        if (els.accumulator) els.accumulator.style.display = "none";
                        if (els.turnIndicator) els.turnIndicator.style.display = "none";
                        
                        // 2. Animación de pérdida
                        (window as any).animateLoss(currentValue, () => {
                            // 3. Actualizar estado y UI mientras están ocultos
                            const opp = state.activePlayerIndex === 0 ? 1 : 0;
                            state.scores[opp] += state.accumulator;
                            state.accumulator = 1;
                            state.activePlayerIndex = opp;
                            updateUI();
                            
                            // 4. Resetear estado visual y mostrar
                            if (els.accumulator) {
                                els.accumulator.classList.remove("spinning");
                                els.accumulator.style.opacity = "0";
                                els.accumulator.style.transform = "rotateY(-90deg)";
                                els.accumulator.style.display = "";
                            }
                            if (els.turnIndicator) {
                                els.turnIndicator.classList.remove("spinning");
                                els.turnIndicator.style.opacity = "0";
                                els.turnIndicator.style.transform = "rotateY(-90deg)";
                                els.turnIndicator.style.display = "";
                            }
                            
                            // 5. Aplicar animación en el siguiente frame
                            requestAnimationFrame(() => {
                                if (els.accumulator) {
                                    els.accumulator.style.opacity = "";
                                    els.accumulator.style.transform = "";
                                    els.accumulator.classList.add("spinning-in");
                                }
                                if (els.turnIndicator) {
                                    els.turnIndicator.style.opacity = "";
                                    els.turnIndicator.style.transform = "";
                                    els.turnIndicator.classList.add("spinning-in");
                                }
                                
                                // 6. Limpiar clases y desbloquear botones
                                setTimeout(() => {
                                    if (els.accumulator) els.accumulator.classList.remove("spinning-in");
                                    if (els.turnIndicator) els.turnIndicator.classList.remove("spinning-in");
                                    if (els.btnSigue) els.btnSigue.disabled = false;
                                    if (els.btnPierde) els.btnPierde.disabled = false;
                                }, 400);
                            });
                        });
                    }, 400);
                };
            }

            if (els.openMenu)
                els.openMenu.onclick = () =>
                    views.modal?.classList.remove("hidden");
            if (els.closeMenu)
                els.closeMenu.onclick = () =>
                    views.modal?.classList.add("hidden");
            if (els.confirmExit)
                els.confirmExit.onclick = () => {
                    window.location.href = "./";
                };

            if (els.playAgain)
                els.playAgain.onclick = () => {
                    state.scores = [0, 0];
                    state.accumulator = 1;
                    state.gameOver = false;
                    views.winner?.classList.add("hidden");
                    views.game?.classList.remove("hidden");
                    updateUI();
                };

            if (els.goMenu)
                els.goMenu.onclick = () => {
                    window.location.href = "./";
                };

            // Initial UI update
            updateUI();

            // Prevent scroll/zoom
            document.addEventListener(
                "touchmove",
                (e) => {
                    const target = e.target as HTMLElement;
                    if (target && target.tagName !== "BUTTON")
                        e.preventDefault();
                },
                { passive: false },
            );
        </script>
    </body>
</html>
