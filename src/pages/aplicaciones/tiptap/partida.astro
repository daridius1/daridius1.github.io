---
import BallAnimation from "./BallAnimation.astro";
import LossAnimation from "./LossAnimation.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <title>TipTap | Partida</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                --color-1: #3b82f6;
                --color-2: #ef4444;
                --bg-current: var(--color-1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                -webkit-tap-highlight-color: transparent;
                user-select: none;
            }

            body {
                font-family: "Outfit", sans-serif;
                width: 100vw;
                height: 100vh;
                height: 100svh;
                display: flex;
                flex-direction: column;
                transition: background-color 0.4s ease;
                background-color: var(--bg-current);
                color: white;
                overflow: hidden;
                position: fixed;
            }

            .hidden {
                display: none !important;
            }

            /* --- GAME VIEW --- */
            header {
                flex: 0 0 auto;
                padding: 1.5vh 0;
                display: flex;
                justify-content: center;
                background: rgba(0, 0, 0, 0.1);
                width: 100%;
            }

            .totals {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                width: 100%;
                max-width: 800px;
                align-items: center;
            }

            .total-item {
                text-align: center;
            }

            .total-score {
                font-size: min(8vh, 12vw);
                font-weight: 900;
                display: block;
                line-height: 1;
            }

            .total-label {
                font-size: 0.8rem;
                text-transform: uppercase;
                opacity: 0.7;
                letter-spacing: 0.1em;
            }

            main {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2vh;
                min-height: 0;
            }

            .turn-box {
                font-size: 1rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                background: rgba(255, 255, 255, 0.15);
                padding: 0.5rem 1.5rem;
                border-radius: 100px;
                margin-bottom: 2vh;
                transition:
                    opacity 0.3s,
                    transform 0.3s;
            }

            .turn-box.spinning {
                animation: spinOut 0.4s ease-in-out forwards;
            }

            .accum-value {
                font-size: min(25vh, 35vw);
                font-weight: 900;
                line-height: 0.8;
                margin: 1vh 0;
                transition:
                    opacity 0.3s,
                    transform 0.3s;
            }

            .accum-value.spinning {
                animation: spinOut 0.4s ease-in-out forwards;
            }

            @keyframes spinOut {
                0% {
                    transform: rotateY(0deg);
                    opacity: 1;
                }
                100% {
                    transform: rotateY(90deg);
                    opacity: 0;
                }
            }

            @keyframes spinIn {
                0% {
                    transform: rotateY(-90deg);
                    opacity: 0;
                }
                100% {
                    transform: rotateY(0deg);
                    opacity: 1;
                }
            }

            .accum-value.spinning-in,
            .turn-box.spinning-in {
                animation: spinIn 0.4s ease-in-out forwards;
            }

            .controls {
                flex: 0 0 auto;
                padding: 2vh 4vw;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3vw;
                max-width: 800px;
                width: 100%;
                margin: 0 auto;
            }

            .btn {
                border: none;
                border-radius: 15px;
                padding: 3vh 1rem;
                font-family: inherit;
                font-weight: 900;
                cursor: pointer;
                text-transform: uppercase;
                transition:
                    transform 0.1s,
                    opacity 0.2s;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.2rem;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            }

            .btn:active {
                transform: scale(0.95);
            }

            .btn-plus {
                background: white;
                color: black;
                font-size: clamp(0.9rem, 3vw, 1.2rem);
            }

            .btn-dump {
                background: rgba(0, 0, 0, 0.3);
                color: white;
                border: 2px solid rgba(255, 255, 255, 0.2);
                font-size: clamp(0.9rem, 3vw, 1.2rem);
            }

            .btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

            /* --- MODAL STYLES --- */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.8);
                backdrop-filter: blur(10px);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 100;
                padding: 2rem;
            }

            .modal-content {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                padding: 2rem;
                border-radius: 25px;
                text-align: center;
                max-width: 400px;
                width: 100%;
            }

            .modal-title {
                font-size: 1.5rem;
                font-weight: 900;
                margin-bottom: 1rem;
            }

            .modal-actions {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                margin-top: 2rem;
            }

            .btn-modal {
                padding: 1rem;
                border-radius: 15px;
                border: none;
                font-family: inherit;
                font-weight: 700;
                cursor: pointer;
                text-transform: uppercase;
            }

            .btn-confirm {
                background: white;
                color: black;
            }

            .btn-cancel {
                background: rgba(255, 255, 255, 0.1);
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.2);
            }

            .menu-btn {
                background: rgba(0, 0, 0, 0.2);
                border: none;
                color: white;
                padding: 0.5rem;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .header-buttons {
                display: flex;
                gap: 0.5rem;
            }

            .sound-btn {
                background: rgba(0, 0, 0, 0.2);
                border: none;
                color: white;
                padding: 0.5rem;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sound-btn svg {
                width: 20px;
                height: 20px;
            }

            .sound-btn.muted {
                opacity: 0.5;
            }

            .start-game-btn {
                background: white;
                color: black;
                border: none;
                padding: 1.2rem 3rem;
                border-radius: 50px;
                font-size: 1.5rem;
                font-weight: 900;
                text-transform: uppercase;
                cursor: pointer;
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
                transition: transform 0.2s;
            }

            @media (max-height: 500px) {
                header {
                    padding: 0.5rem 1rem;
                }
                .total-score {
                    font-size: 1.2rem;
                }
                .turn-box {
                    font-size: 0.8rem;
                    margin-bottom: 0.5vh;
                }
                .accum-value {
                    font-size: 35vh;
                }
                .btn {
                    padding: 1.5rem 0.5rem;
                }
            }

            /* --- UNDO BAR --- */
            .undo-bar {
                flex: 0 0 auto;
                padding: 0.5vh 4vw 1.5vh;
                max-width: 800px;
                width: 100%;
                margin: 0 auto;
            }

            .btn-undo {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                padding: 0.8rem;
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.15);
                background: rgba(255, 255, 255, 0.06);
                color: rgba(255, 255, 255, 0.7);
                font-family: inherit;
                font-weight: 700;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                cursor: pointer;
                transition: all 0.2s;
            }

            .btn-undo:disabled {
                opacity: 0.25;
                cursor: not-allowed;
            }

            .btn-undo:not(:disabled):active {
                transform: scale(0.97);
                background: rgba(255, 255, 255, 0.12);
            }

            /* --- QUICK MODE --- */
            .quick-controls {
                flex: 1;
                display: flex;
                flex-direction: column;
                width: 100%;
                padding: 2vh 3vw;
                gap: 2vh;
            }

            .q-btn {
                border: none;
                border-radius: 16px;
                font-family: inherit;
                font-weight: 900;
                text-transform: uppercase;
                cursor: pointer;
                transition:
                    transform 0.1s,
                    filter 0.1s;
                color: white;
            }

            .q-btn:active {
                transform: scale(0.97);
                filter: brightness(0.85);
            }

            .q-btn:disabled {
                opacity: 0.3;
                cursor: not-allowed;
            }

            .q-btn-sigue {
                flex: 3;
                background: rgba(255, 255, 255, 0.15);
                border: 2px solid rgba(255, 255, 255, 0.25);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 1vh;
            }

            .q-sigue-turn {
                font-size: min(5vw, 3vh);
                opacity: 0.8;
                letter-spacing: 0.1em;
            }

            .q-sigue-acc {
                font-size: min(35vw, 25vh);
                font-weight: 900;
                line-height: 1;
            }

            .q-sigue-text {
                font-size: min(6vw, 4vh);
                opacity: 0.6;
                letter-spacing: 0.2em;
            }

            .q-bottom-row {
                flex: 1;
                display: flex;
                gap: 2vw;
            }

            .q-btn-pierde {
                flex: 2;
                background: rgba(0, 0, 0, 0.25);
                border: 2px solid rgba(255, 255, 255, 0.15);
                font-size: min(8vw, 6vh);
            }

            .q-btn-undo {
                flex: 1;
                background: rgba(255, 255, 255, 0.08);
                color: rgba(255, 255, 255, 0.7);
                border: 2px solid rgba(255, 255, 255, 0.1);
                font-size: min(4vw, 3vh);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.5vh;
            }

            /* --- SETTINGS STYLES --- */
            .setting-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1rem 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .setting-label {
                font-weight: 600;
                font-size: 0.95rem;
            }

            .setting-section {
                padding: 1rem 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                display: flex;
                flex-direction: column;
                gap: 0.8rem;
            }

            .switch {
                position: relative;
                display: inline-block;
                width: 52px;
                height: 28px;
            }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

            .slider {
                position: absolute;
                cursor: pointer;
                inset: 0;
                background: rgba(255, 255, 255, 0.15);
                border-radius: 28px;
                transition: 0.3s;
            }

            .slider::before {
                content: "";
                position: absolute;
                height: 22px;
                width: 22px;
                left: 3px;
                bottom: 3px;
                background: white;
                border-radius: 50%;
                transition: 0.3s;
            }

            .switch input:checked + .slider {
                background: rgba(255, 255, 255, 0.5);
            }

            .switch input:checked + .slider::before {
                transform: translateX(24px);
            }

            .score-inputs {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0.8rem;
            }

            .score-input-group {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
            }

            .score-input-label {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                opacity: 0.6;
                font-weight: 700;
            }

            .score-input {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 10px;
                padding: 0.7rem 1rem;
                color: white;
                font-family: inherit;
                font-size: 1.2rem;
                font-weight: 700;
                text-align: center;
                outline: none;
                width: 100%;
                -moz-appearance: textfield;
            }

            .score-input::-webkit-outer-spin-button,
            .score-input::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

            .score-input:focus {
                border-color: white;
            }

            .btn-apply {
                background: rgba(255, 255, 255, 0.15) !important;
                color: white !important;
                border: 1px solid rgba(255, 255, 255, 0.2) !important;
                font-size: 0.85rem !important;
            }

            .btn-apply:active {
                background: rgba(255, 255, 255, 0.25) !important;
            }
        </style>
    </head>
    <body>
        <!-- GAME VIEW -->
        <section
            id="game-view"
            style="flex: 1; display: flex; flex-direction: column;"
        >
            <header>
                <div class="totals">
                    <div class="total-item">
                        <span class="total-score" id="score1Val">0</span>
                        <span class="total-label" id="score1Label">P1</span>
                    </div>
                    <div class="header-buttons">
                        <button id="soundBtn" class="sound-btn">
                            <svg
                                id="soundIcon"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <polygon
                                    points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"
                                ></polygon>
                                <path
                                    d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
                                ></path>
                            </svg>
                        </button>
                        <button id="openMenu" class="menu-btn">
                            <svg
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                                ></path>
                            </svg>
                        </button>
                    </div>
                    <div class="total-item">
                        <span class="total-score" id="score2Val">0</span>
                        <span class="total-label" id="score2Label">P2</span>
                    </div>
                </div>
            </header>

            <main>
                <div class="turn-box" id="turnIndicator">Cargando...</div>
                <div class="accum-wrapper" style="position: relative;">
                    <div class="accum-value" id="accumulator">1</div>
                </div>
            </main>

            <BallAnimation />
            <LossAnimation />

            <div class="controls" id="controlsNormal">
                <button id="btnSigue" class="btn btn-plus">SIGUE</button>
                <button id="btnPierde" class="btn btn-dump">PIERDE</button>
            </div>

            <div class="undo-bar" id="undoBar">
                <button id="btnUndo" class="btn-undo" disabled>
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 10h13a4 4 0 0 1 0 8H7"></path><path
                            d="m3 10 4-4"></path><path d="m3 10 4 4"
                        ></path></svg
                    >
                    DESHACER
                </button>
            </div>

            <!-- QUICK MODE -->
            <div id="quickControls" class="quick-controls hidden">
                <button id="qBtnSigue" class="q-btn q-btn-sigue">
                    <span class="q-sigue-turn" id="qSigueTurn"
                        >TURNO DE JUGADOR 1</span
                    >
                    <span class="q-sigue-acc" id="qSigueAcc">1</span>
                    <span class="q-sigue-text">SIGUE</span>
                </button>
                <div class="q-bottom-row">
                    <button id="qBtnPierde" class="q-btn q-btn-pierde"
                        >PIERDE</button
                    >
                    <button id="qBtnUndo" class="q-btn q-btn-undo" disabled>
                        <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="M3 10h13a4 4 0 0 1 0 8H7"></path><path
                                d="m3 10 4-4"></path><path d="m3 10 4 4"
                            ></path></svg
                        >
                        DESHACER
                    </button>
                </div>
            </div>
        </section>

        <!-- SETTINGS MODAL -->
        <div id="menu-modal" class="modal-overlay hidden">
            <div class="modal-content">
                <h3 class="modal-title">Configuración</h3>

                <div class="setting-row">
                    <span class="setting-label">Marcador rápido</span>
                    <label class="switch">
                        <input type="checkbox" id="quickModeToggle" />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-section">
                    <span class="setting-label">Marcador manual</span>
                    <div class="score-inputs">
                        <div class="score-input-group">
                            <label class="score-input-label" id="setScoreLabel1"
                                >P1</label
                            >
                            <input
                                type="number"
                                id="setScore1"
                                class="score-input"
                                min="0"
                                value="0"
                            />
                        </div>
                        <div class="score-input-group">
                            <label class="score-input-label" id="setScoreLabel2"
                                >P2</label
                            >
                            <input
                                type="number"
                                id="setScore2"
                                class="score-input"
                                min="0"
                                value="0"
                            />
                        </div>
                    </div>
                    <button id="applyScores" class="btn-modal btn-apply"
                        >APLICAR PUNTAJES</button
                    >
                </div>

                <div class="modal-actions">
                    <button id="confirmExit" class="btn-modal btn-confirm"
                        >VOLVER AL MENÚ</button
                    >
                    <button id="closeMenu" class="btn-modal btn-cancel"
                        >CERRAR</button
                    >
                </div>
            </div>
        </div>

        <!-- WINNER VIEW -->
        <section
            id="winner-view"
            class="hidden"
            style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem;"
        >
            <h2
                style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.3em; opacity: 0.8;"
            >
                ¡Tenemos un ganador!
            </h2>
            <h1
                id="winner-name"
                style="font-size: clamp(3rem, 15vw, 6rem); font-weight: 900; margin: 1rem 0;"
            >
                WINNER
            </h1>
            <p style="font-size: 1.2rem; opacity: 0.7; margin-bottom: 3rem;">
                Ha llegado a los 30 puntos.
            </p>
            <button id="playAgain" class="start-game-btn"
                >REPETIR PARTIDA</button
            >
            <button
                id="goMenu"
                style="background: transparent; border: none; color: white; margin-top: 1rem; cursor: pointer; opacity: 0.6; font-weight: 700;"
                >VOLVER AL MENÚ</button
            >
        </section>

        <script>
            const params = new URLSearchParams(window.location.search);
            const p1 = params.get("p1") || "Jugador 1";
            const p2 = params.get("p2") || "Jugador 2";
            const startIndex = params.get("start")
                ? parseInt(params.get("start")!)
                : 0;

            let soundEnabled = localStorage.getItem("tiptap-sound") !== "false";
            const soundBtn = document.getElementById(
                "soundBtn",
            ) as HTMLButtonElement;
            const successAudio = new Audio("/audio/success_bell-6776.mp3");
            successAudio.volume = 0.8;
            (successAudio as any).preservesPitch = false;
            (successAudio as any).mozPreservesPitch = false;
            (successAudio as any).webkitPreservesPitch = false;
            const errorAudio = new Audio("/audio/error-010-206498.mp3");
            errorAudio.volume = 0.35;

            function updateSoundButton() {
                const si = document.getElementById("soundIcon");
                if (soundBtn && si) {
                    si.innerHTML = soundEnabled
                        ? '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>'
                        : '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line>';
                    soundBtn.classList.toggle("muted", !soundEnabled);
                }
            }
            updateSoundButton();
            if (soundBtn)
                soundBtn.onclick = () => {
                    soundEnabled = !soundEnabled;
                    localStorage.setItem(
                        "tiptap-sound",
                        soundEnabled.toString(),
                    );
                    updateSoundButton();
                };

            let quickMode = localStorage.getItem("tiptap-quick") === "true";
            const state = {
                players: [p1, p2],
                scores: [0, 0] as number[],
                accumulator: 1,
                activePlayerIndex: startIndex,
                gameOver: false,
            };
            const history: {
                scores: number[];
                accumulator: number;
                activePlayerIndex: number;
            }[] = [];
            const colors = ["#3b82f6", "#ef4444"];
            const WIN_SCORE = 30;

            function saveSnap() {
                history.push({
                    scores: [...state.scores],
                    accumulator: state.accumulator,
                    activePlayerIndex: state.activePlayerIndex,
                });
                updateUndoBtns();
            }
            function undo() {
                if (!history.length) return;
                const s = history.pop()!;
                Object.assign(state, {
                    scores: s.scores,
                    accumulator: s.accumulator,
                    activePlayerIndex: s.activePlayerIndex,
                    gameOver: false,
                });
                views.winner?.classList.add("hidden");
                views.game?.classList.remove("hidden");
                if (soundEnabled) {
                    successAudio.currentTime = 0;
                    successAudio.playbackRate = 0.7;
                    successAudio.play().catch(() => {});
                }
                updateUI();
                updateUndoBtns();
            }
            function updateUndoBtns() {
                const h = history.length > 0;
                const a = document.getElementById(
                    "btnUndo",
                ) as HTMLButtonElement | null;
                const b = document.getElementById(
                    "qBtnUndo",
                ) as HTMLButtonElement | null;
                if (a) a.disabled = !h;
                if (b) b.disabled = !h;
            }

            const views = {
                game: document.getElementById("game-view"),
                winner: document.getElementById("winner-view"),
                modal: document.getElementById("menu-modal"),
            };
            const els = {
                s1: document.getElementById("score1Val"),
                s2: document.getElementById("score2Val"),
                l1: document.getElementById("score1Label"),
                l2: document.getElementById("score2Label"),
                acc: document.getElementById("accumulator"),
                turn: document.getElementById("turnIndicator"),
                sigue: document.getElementById(
                    "btnSigue",
                ) as HTMLButtonElement | null,
                pierde: document.getElementById(
                    "btnPierde",
                ) as HTMLButtonElement | null,
                openMenu: document.getElementById("openMenu"),
                closeMenu: document.getElementById("closeMenu"),
                exit: document.getElementById("confirmExit"),
                wName: document.getElementById("winner-name"),
                again: document.getElementById("playAgain"),
                goMenu: document.getElementById("goMenu"),
            };
            const qEls = {
                wrap: document.getElementById("quickControls"),
                norm: document.getElementById("controlsNormal"),
                uBar: document.getElementById("undoBar"),
                main: document.querySelector("main") as HTMLElement | null,
                sigue: document.getElementById(
                    "qBtnSigue",
                ) as HTMLButtonElement | null,
                sigueTurn: document.getElementById("qSigueTurn"),
                sigueAcc: document.getElementById("qSigueAcc"),
                pierde: document.getElementById(
                    "qBtnPierde",
                ) as HTMLButtonElement | null,
            };

            function applyQuickMode() {
                const show = (el: HTMLElement | null, v: boolean) => {
                    if (el) el.classList.toggle("hidden", !v);
                };
                show(qEls.wrap, quickMode);
                show(qEls.norm, !quickMode);
                show(qEls.uBar, !quickMode);
                if (qEls.main) qEls.main.classList.toggle("hidden", quickMode);
                document.body.style.backgroundColor =
                    colors[state.activePlayerIndex];
                updateUI();
            }

            function updateUI() {
                if (
                    state.scores[0] >= WIN_SCORE ||
                    state.scores[1] >= WIN_SCORE
                ) {
                    state.gameOver = true;
                    views.game?.classList.add("hidden");
                    views.winner?.classList.remove("hidden");
                    const w = state.scores[0] >= WIN_SCORE ? 0 : 1;
                    if (els.wName)
                        els.wName.textContent = state.players[w].toUpperCase();
                    document.body.style.backgroundColor = colors[w];
                    return;
                }
                // Normal mode
                if (els.s1) els.s1.textContent = state.scores[0].toString();
                if (els.s2) els.s2.textContent = state.scores[1].toString();
                if (els.l1) els.l1.textContent = state.players[0];
                if (els.l2) els.l2.textContent = state.players[1];
                if (els.acc) els.acc.textContent = state.accumulator.toString();
                if (els.turn)
                    els.turn.textContent = `Turno de ${state.players[state.activePlayerIndex]}`;
                document.body.style.backgroundColor =
                    colors[state.activePlayerIndex];

                // Quick mode updates
                if (qEls.sigueTurn)
                    qEls.sigueTurn.textContent = `Turno de ${state.players[state.activePlayerIndex]}`;
                if (qEls.sigueAcc)
                    qEls.sigueAcc.textContent = state.accumulator.toString();
            }

            // Normal mode: SIGUE
            if (els.sigue) {
                els.sigue.onclick = () => {
                    if (state.gameOver) return;
                    saveSnap();
                    if (els.sigue) els.sigue.disabled = true;
                    if (els.pierde) els.pierde.disabled = true;
                    const cv = state.accumulator;
                    const dir =
                        state.activePlayerIndex === 0
                            ? "left-to-right"
                            : "right-to-left";
                    if (soundEnabled) {
                        successAudio.currentTime = 0;
                        successAudio.playbackRate = Math.min(
                            1.0 + (cv - 1) * 0.06,
                            2.0,
                        );
                        successAudio.play().catch(() => {});
                    }
                    if (els.acc) els.acc.classList.add("spinning");
                    if (els.turn) els.turn.classList.add("spinning");
                    setTimeout(() => {
                        if (els.acc) els.acc.style.display = "none";
                        if (els.turn) els.turn.style.display = "none";
                        (window as any).animateBall(cv, dir, () => {
                            state.accumulator++;
                            state.activePlayerIndex =
                                state.activePlayerIndex === 0 ? 1 : 0;
                            updateUI();
                            if (els.acc) {
                                els.acc.classList.remove("spinning");
                                els.acc.style.opacity = "0";
                                els.acc.style.transform = "rotateY(-90deg)";
                                els.acc.style.display = "";
                            }
                            if (els.turn) {
                                els.turn.classList.remove("spinning");
                                els.turn.style.opacity = "0";
                                els.turn.style.transform = "rotateY(-90deg)";
                                els.turn.style.display = "";
                            }
                            requestAnimationFrame(() => {
                                if (els.acc) {
                                    els.acc.style.opacity = "";
                                    els.acc.style.transform = "";
                                    els.acc.classList.add("spinning-in");
                                }
                                if (els.turn) {
                                    els.turn.style.opacity = "";
                                    els.turn.style.transform = "";
                                    els.turn.classList.add("spinning-in");
                                }
                                setTimeout(() => {
                                    if (els.acc)
                                        els.acc.classList.remove("spinning-in");
                                    if (els.turn)
                                        els.turn.classList.remove(
                                            "spinning-in",
                                        );
                                    if (els.sigue) els.sigue.disabled = false;
                                    if (els.pierde) els.pierde.disabled = false;
                                }, 400);
                            });
                        });
                    }, 400);
                };
            }

            // Normal mode: PIERDE
            if (els.pierde) {
                els.pierde.onclick = () => {
                    if (state.gameOver) return;
                    saveSnap();
                    if (els.sigue) els.sigue.disabled = true;
                    if (els.pierde) els.pierde.disabled = true;
                    const cv = state.accumulator;
                    if (soundEnabled) {
                        errorAudio.currentTime = 0;
                        errorAudio.play().catch(() => {});
                    }
                    if (els.acc) els.acc.classList.add("spinning");
                    if (els.turn) els.turn.classList.add("spinning");
                    setTimeout(() => {
                        if (els.acc) els.acc.style.display = "none";
                        if (els.turn) els.turn.style.display = "none";
                        (window as any).animateLoss(cv, () => {
                            const opp = state.activePlayerIndex === 0 ? 1 : 0;
                            state.scores[opp] += state.accumulator;
                            state.accumulator = 1;
                            state.activePlayerIndex = opp;
                            updateUI();
                            if (els.acc) {
                                els.acc.classList.remove("spinning");
                                els.acc.style.opacity = "0";
                                els.acc.style.transform = "rotateY(-90deg)";
                                els.acc.style.display = "";
                            }
                            if (els.turn) {
                                els.turn.classList.remove("spinning");
                                els.turn.style.opacity = "0";
                                els.turn.style.transform = "rotateY(-90deg)";
                                els.turn.style.display = "";
                            }
                            requestAnimationFrame(() => {
                                if (els.acc) {
                                    els.acc.style.opacity = "";
                                    els.acc.style.transform = "";
                                    els.acc.classList.add("spinning-in");
                                }
                                if (els.turn) {
                                    els.turn.style.opacity = "";
                                    els.turn.style.transform = "";
                                    els.turn.classList.add("spinning-in");
                                }
                                setTimeout(() => {
                                    if (els.acc)
                                        els.acc.classList.remove("spinning-in");
                                    if (els.turn)
                                        els.turn.classList.remove(
                                            "spinning-in",
                                        );
                                    if (els.sigue) els.sigue.disabled = false;
                                    if (els.pierde) els.pierde.disabled = false;
                                }, 400);
                            });
                        });
                    }, 400);
                };
            }

            // Quick mode handlers
            if (qEls.sigue) {
                qEls.sigue.onclick = () => {
                    if (state.gameOver) return;
                    saveSnap();
                    const cv = state.accumulator;
                    if (soundEnabled) {
                        successAudio.currentTime = 0;
                        successAudio.playbackRate = Math.min(
                            1.0 + (cv - 1) * 0.06,
                            2.0,
                        );
                        successAudio.play().catch(() => {});
                    }
                    state.accumulator++;
                    state.activePlayerIndex =
                        state.activePlayerIndex === 0 ? 1 : 0;
                    updateUI();
                };
            }
            if (qEls.pierde) {
                qEls.pierde.onclick = () => {
                    if (state.gameOver) return;
                    saveSnap();
                    if (soundEnabled) {
                        errorAudio.currentTime = 0;
                        errorAudio.play().catch(() => {});
                    }
                    const opp = state.activePlayerIndex === 0 ? 1 : 0;
                    state.scores[opp] += state.accumulator;
                    state.accumulator = 1;
                    state.activePlayerIndex = opp;
                    updateUI();
                };
            }

            // Undo buttons
            document.getElementById("btnUndo")?.addEventListener("click", undo);
            document
                .getElementById("qBtnUndo")
                ?.addEventListener("click", undo);

            // Settings modal
            const quickToggle = document.getElementById(
                "quickModeToggle",
            ) as HTMLInputElement | null;
            const applyScoresBtn = document.getElementById("applyScores");
            const setS1 = document.getElementById(
                "setScore1",
            ) as HTMLInputElement | null;
            const setS2 = document.getElementById(
                "setScore2",
            ) as HTMLInputElement | null;
            const setSL1 = document.getElementById("setScoreLabel1");
            const setSL2 = document.getElementById("setScoreLabel2");

            if (quickToggle) {
                quickToggle.checked = quickMode;
                quickToggle.onchange = () => {
                    quickMode = quickToggle.checked;
                    localStorage.setItem("tiptap-quick", quickMode.toString());
                    applyQuickMode();
                };
            }
            if (els.openMenu)
                els.openMenu.onclick = () => {
                    if (setS1) setS1.value = state.scores[0].toString();
                    if (setS2) setS2.value = state.scores[1].toString();
                    if (setSL1) setSL1.textContent = state.players[0];
                    if (setSL2) setSL2.textContent = state.players[1];
                    views.modal?.classList.remove("hidden");
                };
            if (els.closeMenu)
                els.closeMenu.onclick = () =>
                    views.modal?.classList.add("hidden");
            if (els.exit)
                els.exit.onclick = () => {
                    window.location.href = "./";
                };
            if (applyScoresBtn)
                applyScoresBtn.onclick = () => {
                    saveSnap();
                    state.scores[0] = Math.max(
                        0,
                        parseInt(setS1?.value || "0") || 0,
                    );
                    state.scores[1] = Math.max(
                        0,
                        parseInt(setS2?.value || "0") || 0,
                    );
                    if (soundEnabled) {
                        successAudio.currentTime = 0;
                        successAudio.playbackRate = 1.0;
                        successAudio.play().catch(() => {});
                    }
                    updateUI();
                    views.modal?.classList.add("hidden");
                };

            if (els.again)
                els.again.onclick = () => {
                    state.scores = [0, 0];
                    state.accumulator = 1;
                    state.gameOver = false;
                    history.length = 0;
                    views.winner?.classList.add("hidden");
                    views.game?.classList.remove("hidden");
                    updateUndoBtns();
                    applyQuickMode();
                };
            if (els.goMenu)
                els.goMenu.onclick = () => {
                    window.location.href = "./";
                };

            applyQuickMode();
            updateUndoBtns();
            document.addEventListener(
                "touchmove",
                (e) => {
                    const t = e.target as HTMLElement;
                    if (t && t.tagName !== "BUTTON" && t.tagName !== "INPUT")
                        e.preventDefault();
                },
                { passive: false },
            );
        </script>
    </body>
</html>
