---
// Componente de animación cuando un jugador pierde
---

<div class="loss-container" id="lossContainer">
    <div class="loss-text" id="lossText"></div>
</div>

<style>
    .loss-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100vw;
        height: 100vh;
        display: none;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 10;
    }

    .loss-container.active {
        display: flex;
    }

    .loss-text {
        font-size: min(20vh, 25vw);
        font-weight: 900;
        color: white;
        text-transform: uppercase;
        opacity: 0;
        transform: scale(0.5);
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        max-width: 90vw;
        word-wrap: break-word;
        text-align: center;
    }

    .loss-text.show {
        opacity: 1;
        transform: scale(1);
    }

    .loss-text.hide {
        opacity: 0;
        transform: scale(1.5);
        transition: all 0.2s ease-out;
    }
</style>

<script>
    // Función global para animar la pérdida
    (window as any).animateLoss = function(
        turnNumber: number,
        callback: () => void
    ) {
        const container = document.getElementById("lossContainer");
        const textElement = document.getElementById("lossText");
        const accumulator = document.getElementById("accumulator");
        const turnIndicator = document.getElementById("turnIndicator");
        
        if (!container || !textElement) return;
        
        // Palabras según el turno
        const words = [
            "flek",    // 1
            "fleux",   // 2
            "flan",    // 3
            "flier",   // 4
            "flyat",   // 5
            "flix",    // 6
            "flete",   // 7
            "flotto",  // 8
            "fliu",    // 9
            "flip",    // 10
            "fleka",   // 11
            "floce"    // 12
        ];
        
        const word = turnNumber > 12 ? "flop" : words[turnNumber - 1];
        
        // Ocultar contador y turno
        if (accumulator) accumulator.style.display = "none";
        if (turnIndicator) turnIndicator.style.display = "none";
        
        // Establecer texto y estado inicial
        textElement.textContent = word;
        textElement.classList.remove("show", "hide");
        
        // Mostrar container
        container.classList.add("active");
        
        // Animar entrada con doble requestAnimationFrame para asegurar renderizado
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                textElement.classList.add("show");
            });
        });
        
        // Animar salida y callback
        setTimeout(() => {
            textElement.classList.remove("show");
            textElement.classList.add("hide");
            
            setTimeout(() => {
                container.classList.remove("active");
                textElement.classList.remove("hide");
                textElement.textContent = "";
                if (accumulator) accumulator.style.display = "block";
                if (turnIndicator) turnIndicator.style.display = "block";
                callback();
            }, 200);
        }, 1200);
    };
</script>
